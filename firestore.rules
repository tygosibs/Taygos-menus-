        data.id == promoId &&
        data.code == promoId &&
        data.discountType in ['percent', 'fixed', 'free_month'] &&
        data.discountValue is number && data.discountValue >= 0 && data.discountValue <= 100000 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 200)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomTheme(data, themeId) {
      return data.keys().hasAll([
          'id', 'name', 'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'name_en', 'description', 'description_en', 'previewImage',
          'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == themeId &&
        data.id.matches('^custom_[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 400)) &&
        (!('previewImage' in data) || (data.previewImage is string && data.previewImage.size() <= 300000)) &&
        data.htmlCode is string && data.htmlCode.size() <= 150000 &&
        data.cssCode is string && data.cssCode.size() <= 100000 &&
        data.jsCode is string && data.jsCode.size() <= 100000 &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    // 1. Users collection (owner-only PII + Super Admin read)
    match /users/{userId} {
      allow get: if isSuperAdmin() || (isVerifiedAccount() && isValidId(userId) && request.auth.uid == userId);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 2. Slugs lookup collection
    match /slugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().createdAt == request.time;
      allow update: if isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['restaurantId']) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      allow delete: if isValidSlug(slug) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 3. Restaurants collection
    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId);
      allow list: if isSuperAdmin() || (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedAccount() && isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid && (
              incoming().diff(existing()).affectedKeys().hasOnly(['activeTheme', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'ownerBirthday', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ]) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'appliedPlatformPromoCode', 'appliedPlatformPromoSummary', 'appliedPlatformPromoSummary_en', 'updatedAt'
                ]) &&
                isValidPromoCodeId(incoming().appliedPlatformPromoCode) &&
                exists(/databases/$(database)/documents/platform_promo_codes/$(incoming().appliedPlatformPromoCode)) &&
                get(/databases/$(database)/documents/platform_promo_codes/$(incoming().appliedPlatformPromoCode)).data.isActive == true
              )
            )
          ) || (
            isSuperAdmin() && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isSuspended', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'isSuspended', 'ownerBirthday', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'appliedPlatformPromoCode', 'appliedPlatformPromoSummary', 'appliedPlatformPromoSummary_en', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isValidId(restaurantId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );

      // 3b. Table Sessions subcollection (Live Group Cart per dining table)
      match /table_sessions/{sessionId} {
        allow get: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid)
        );
        allow create: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId;
        allow update: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && (
            (
              existing().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              existing().status == 'closed' &&
              incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              (
                isSuperAdmin() ||
                (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
                staffHasScreen(restaurantId, 'cashier') ||
                staffHasScreen(restaurantId, 'captain')
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'lastOrderNumber', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(sessionId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
          staffHasScreen(restaurantId, 'cashier')
        );
      }

      // 3c. Customers Loyalty & Personalization subcollection (keyed by phone)
      match /customers/{customerPhone} {
        allow get: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid)
        );
        allow create: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          isValidCustomerShape(incoming(), restaurantId, customerPhone) &&
          incoming().totalOrders == 0 &&
          incoming().loyaltyCycleOrders == 0 &&
          incoming().firstOrderDiscountUsed == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId;
        allow update: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          isValidCustomerShape(incoming(), restaurantId, customerPhone) &&
          incoming().id == existing().id &&
          incoming().phone == existing().phone &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (existing().firstOrderDiscountUsed == false || incoming().firstOrderDiscountUsed == true) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && (
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'birthDay', 'birthMonth', 'birthYear', 'preferredOrderType', 'address', 'updatedAt'
              ])
            ) || (
              incoming().totalOrders >= existing().totalOrders &&
              incoming().totalOrders <= existing().totalOrders + 1 &&
              incoming().lastVisitAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'preferredOrderType', 'address',
                'totalOrders', 'loyaltyCycleOrders', 'firstOrderDiscountUsed',
                'lastVisitAt', 'favoriteItems', 'lastOrderItems', 'updatedAt'
              ])
            ) || (
              isSuperAdmin() ||
              (isVerifiedAccount() && existing().ownerId == request.auth.uid)
            )
          );
        allow delete: if isValidId(restaurantId) && isValidPhoneId(customerPhone) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      }

      // 3d. Staff Members subcollection (Strictly Owner, Manager, or self-get; NEVER non-manager list!)
      match /staff/{staffUid} {
        allow get: if isValidId(restaurantId) && isValidId(staffUid) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && request.auth.uid == staffUid && existing().restaurantId == restaurantId)
        );
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(staffUid) &&
          isValidStaffMemberShape(incoming(), restaurantId, staffUid) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              incoming().createdBy == request.auth.uid &&
              incoming().role != 'manager' &&
              !('staff_management' in incoming().allowedScreens)
            )
          );
        allow update: if isValidId(restaurantId) && isValidId(staffUid) &&
          isValidStaffMemberShape(incoming(), restaurantId, staffUid) &&
          incoming().uid == existing().uid &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().username == existing().username &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              (existing().role != 'manager' || request.auth.uid == staffUid) &&
              incoming().role == existing().role &&
              (existing().role == 'manager' || !('staff_management' in incoming().allowedScreens))
            ) || (
              // Self one-time QR onboarding activation
              isSignedIn() &&
              request.auth.uid == staffUid &&
              existing().mustChangePassword == true &&
              existing().activeInviteHash != '' &&
              exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_invites/$(existing().activeInviteHash)) &&
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_invites/$(existing().activeInviteHash)).data.staffId == request.auth.uid &&
              incoming().role == existing().role &&
              incoming().allowedScreens == existing().allowedScreens &&
              incoming().defaultScreen == existing().defaultScreen &&
              incoming().isActive == true &&
              incoming().mustChangePassword == false &&
              incoming().passwordChangedAt == request.time &&
              incoming().lastLoginAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'phone', 'email', 'jobTitle', 'hallId', 'hallName',
                'isActive', 'mustChangePassword', 'passwordChangedAt', 'lastLoginAt', 'updatedAt'
              ])
            ) || (
              // Active employee login timestamp or forced password update
              isSignedIn() &&
              request.auth.uid == staffUid &&
              existing().isActive == true && (
                (
                  incoming().lastLoginAt == request.time &&
                  incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt'])
                ) || (
                  incoming().mustChangePassword == false &&
                  incoming().passwordChangedAt == request.time &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'mustChangePassword', 'passwordChangedAt', 'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(staffUid) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          (isActiveManagerForRestaurant(restaurantId) && existing().role != 'manager')
        );
      }

      // 3e. One-Time Staff QR Invites (hashed tokenId = inviteId; single-use 24h activation)
      match /staff_invites/{inviteId} {
        allow get: if isValidId(restaurantId) && isValidId(inviteId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(inviteId) &&
          isValidStaffInviteShape(incoming(), restaurantId, inviteId) &&
          !('usedAt' in incoming()) &&
          !('revokedAt' in incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              incoming().createdBy == request.auth.uid &&
              incoming().staffRole != 'manager' &&
              !('staff_management' in incoming().allowedScreens)
            )
          );
        allow update: if isValidId(restaurantId) && isValidId(inviteId) &&
          isValidStaffInviteShape(incoming(), restaurantId, inviteId) &&
          incoming().id == existing().id &&
          incoming().staffId == existing().staffId &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().tokenHash == existing().tokenHash &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            (
              (isOwnerOfRestaurant(restaurantId) || (isActiveManagerForRestaurant(restaurantId) && existing().staffRole != 'manager')) &&
              incoming().revokedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['revokedAt', 'updatedAt'])
            ) || (
              isSignedIn() &&
              request.auth.uid == existing().staffId &&
              !('usedAt' in existing()) &&
              !('revokedAt' in existing()) &&
              existing().expiresAt > request.time &&
              incoming().usedAt == request.time &&
              incoming().usedByUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['usedAt', 'usedByUid', 'updatedAt'])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(inviteId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId)
        );
      }

      // 3f. Pre-auth hashed Login Lookup Index (get only for identifier resolution; NO public list!)
      match /staff_login_index/{lookupId} {
        allow get: if isValidId(restaurantId) && isValidId(lookupId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(lookupId) &&
          isValidStaffLoginIndexShape(incoming(), restaurantId, lookupId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (
              isSignedIn() &&
              incoming().staffUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.isActive == true
            )
          );
        allow update: if isValidId(restaurantId) && isValidId(lookupId) &&
          isValidStaffLoginIndexShape(incoming(), restaurantId, lookupId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (
              isSignedIn() &&
              existing().staffUid == request.auth.uid &&
              incoming().staffUid == request.auth.uid &&
              incoming().authEmail == existing().authEmail &&
              incoming().isActive == true &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt'])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(lookupId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffUid == request.auth.uid)
        );
      }

      // 3g. Immutable Staff Accountability & Security Audit Logs
      match /staff_audit_logs/{logId} {
        allow get, list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(logId) &&
          isValidStaffAuditLogShape(incoming(), restaurantId, logId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().actorUid == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().actorUid == request.auth.uid) ||
            (
              isSignedIn() &&
              incoming().actorUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/staff_access/$(request.auth.uid)).data.restaurantId == restaurantId
            )
          );
        allow update: if false;
        allow delete: if isValidId(restaurantId) && isValidId(logId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId)
        );
      }

      // 3g-2. Dynamic Unlimited Kitchen / Prep Stations subcollection
      match /stations/{stationId} {
        allow get: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if true;
        allow create: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          isValidStationShape(incoming(), restaurantId, stationId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (isActiveManagerForRestaurant(restaurantId) && incoming().createdBy == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          isValidStationShape(incoming(), restaurantId, stationId) &&
          incoming().id == existing().id &&
          incoming().stationId == existing().stationId &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'nameEn', 'color', 'icon', 'isActive', 'sortOrder', 'updatedAt'
          ]) && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId)
          );
        allow delete: if isValidId(restaurantId) && isValidStation(stationId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
      }

      // 3g-3. Operational Staff Shifts subcollection (active shift tracking & uncovered station alerts)
      match /staff_shifts/{shiftId} {
        allow get: if isValidId(restaurantId) && isValidId(shiftId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveStaffForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
        allow list: if isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
          isActiveStaffForRestaurant(restaurantId) ||
          (isSignedIn() && resource.data.staffId == request.auth.uid);
        allow create: if isValidId(restaurantId) &&
          isValidId(shiftId) &&
          isValidStaffShiftShape(incoming(), restaurantId, shiftId) &&
          incoming().status == 'active' &&
          incoming().ordersHandled == 0 &&
          incoming().itemsMarkedReady == 0 &&
          incoming().serviceCallsHandled == 0 &&
          incoming().startedAt == request.time &&
          incoming().updatedAt == request.time &&
          !('endedAt' in incoming()) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().staffId == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidId(shiftId) &&
          isValidStaffShiftShape(incoming(), restaurantId, shiftId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().staffId == existing().staffId &&
          incoming().stationId == existing().stationId &&
          incoming().startedAt == existing().startedAt &&
          incoming().updatedAt == request.time && (
            (
              existing().status == 'active' &&
              incoming().status == 'completed' &&
              incoming().endedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt']) && (
                isSuperAdmin() ||
                isOwnerOfRestaurant(restaurantId) ||
                isActiveManagerForRestaurant(restaurantId) ||
                (isActiveStaffForRestaurant(restaurantId) && existing().staffId == request.auth.uid)
              )
            ) || (
              existing().status == 'active' &&
              incoming().status == 'active' &&
              isActiveStaffForRestaurant(restaurantId) &&
              existing().staffId == request.auth.uid && (
                (
                  incoming().diff(existing()).affectedKeys().hasOnly(['ordersHandled', 'updatedAt']) &&
                  incoming().ordersHandled >= existing().ordersHandled &&
                  incoming().ordersHandled <= existing().ordersHandled + 50
                ) || (
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemsMarkedReady', 'updatedAt']) &&
                  incoming().itemsMarkedReady >= existing().itemsMarkedReady &&
                  incoming().itemsMarkedReady <= existing().itemsMarkedReady + 50
                ) || (
                  incoming().diff(existing()).affectedKeys().hasOnly(['serviceCallsHandled', 'updatedAt']) &&
                  incoming().serviceCallsHandled >= existing().serviceCallsHandled &&
                  incoming().serviceCallsHandled <= existing().serviceCallsHandled + 50
                )
              )
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(shiftId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId)
        );
      }

      // 3g-4. Registered Staff PWA Devices & FCM Topic Registrations
      match /staff_devices/{deviceId} {
        allow get: if isValidId(restaurantId) && isValidId(deviceId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
        allow list: if isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && resource.data.staffId == request.auth.uid);
        allow create: if isValidId(restaurantId) &&
          isValidId(deviceId) &&
          isValidStaffDeviceShape(incoming(), restaurantId, deviceId) &&
          incoming().lastSeenAt == request.time &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().staffId == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidId(deviceId) &&
          isValidStaffDeviceShape(incoming(), restaurantId, deviceId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'staffId', 'staffName', 'fcmToken', 'deviceName', 'platform',
            'activeStations', 'topics', 'isActive', 'lastSeenAt', 'updatedAt'
          ]) && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow delete: if isValidId(restaurantId) && isValidId(deviceId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
      }
    }

    // 3h. Top-level Staff RBAC Access Map (indexed strictly by staffUid for fast cross-collection rules)
    match /staff_access/{staffUid} {
      allow get: if isValidId(staffUid) && (
        isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == staffUid) ||
        isOwnerOfRestaurant(existing().restaurantId) ||
        isActiveManagerForRestaurant(existing().restaurantId)
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(staffUid) &&
        isValidStaffAccessShape(incoming(), staffUid) &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(incoming().restaurantId) ||
          (
            isActiveManagerForRestaurant(incoming().restaurantId) &&
            incoming().role != 'manager' &&
            !('staff_management' in incoming().allowedScreens)
          )
        );
      allow update: if isValidId(staffUid) &&
        isValidStaffAccessShape(incoming(), staffUid) &&
        incoming().uid == existing().uid &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(existing().restaurantId) ||
          (
            isActiveManagerForRestaurant(existing().restaurantId) &&
            (existing().role != 'manager' || request.auth.uid == staffUid) &&
            incoming().role == existing().role &&
            (existing().role == 'manager' || !('staff_management' in incoming().allowedScreens))
          ) || (
            isSignedIn() &&
            request.auth.uid == staffUid &&
            existing().mustChangePassword == true &&
            incoming().role == existing().role &&
            incoming().allowedScreens == existing().allowedScreens &&
            incoming().defaultScreen == existing().defaultScreen &&
            incoming().isActive == true &&
            incoming().mustChangePassword == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hallId', 'isActive', 'mustChangePassword', 'updatedAt'
            ])
          ) || (
            isSignedIn() &&
            request.auth.uid == staffUid &&
            existing().isActive == true &&
            incoming().role == existing().role &&
            incoming().allowedScreens == existing().allowedScreens &&
            incoming().defaultScreen == existing().defaultScreen &&
            incoming().mustChangePassword == false &&
            incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
          )
        );
      allow delete: if isValidId(staffUid) && (
        isSuperAdmin() ||
        isOwnerOfRestaurant(existing().restaurantId) ||
        (isActiveManagerForRestaurant(existing().restaurantId) && existing().role != 'manager')
      );
    }

    // 4. Categories collection (linked by restaurantId)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().createdAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'parentId', 'name', 'name_en', 'imageUrl', 'station', 'stationId', 'sortOrder'
        ]) && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          ) ||
          isSuperAdmin()
        );
      allow delete: if isValidId(categoryId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 5. Menu Items collection (linked by restaurantId and categoryId)
    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          (
            (
              isSuperAdmin() || (
                isVerifiedAccount() &&
                existing().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
              )
            ) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isAvailable', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['sortOrder', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'stationId', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'categoryId', 'name', 'name_en', 'description', 'description_en', 'basePrice', 'imageUrl', 'calories',
                'isSpicy', 'isAvailable', 'ordersCount', 'sizes', 'addons', 'badge', 'isBogo', 'suggestedItemIds',
                'station', 'stationId', 'sortOrder', 'updatedAt'
              ])
            )
          ) || (
            incoming().categoryId == existing().categoryId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ordersCount', 'updatedAt']) &&
            incoming().ordersCount > existing().ordersCount &&
            incoming().ordersCount <= existing().ordersCount + 50
          )
        );
      allow delete: if isValidId(itemId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 6. Orders collection (strict isolation: Super Admin, Restaurant Owner, or Staff with matching screen)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
        staffHasAnyOrderScreen(existing().restaurantId)
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
        staffHasAnyOrderScreen(resource.data.restaurantId);
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        !(existing().status in ['completed', 'cancelled']) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          (
            (
              isSuperAdmin() ||
              (
                isVerifiedAccount() &&
                existing().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
              ) ||
              staffHasScreen(existing().restaurantId, 'cashier')
            ) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'closedByUid', 'closedByName', 'closedByRole', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt'])
            )
          ) || (
            (
              staffHasAnyStationAccess(existing().restaurantId) ||
              staffHasScreen(existing().restaurantId, 'captain')
            ) &&
            !(incoming().status in ['completed', 'cancelled']) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt'])
            )
          )
        );
      allow delete: if isSuperAdmin() && isValidId(orderId);
    }

    // 7. Service Calls collection (Captain / Cashier / Owner / Super Admin ONLY; Kitchen/Bar/Pastry isolated!)
    match /service_calls/{callId} {
      allow get: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
        staffHasScreen(existing().restaurantId, 'cashier') ||
        staffHasScreen(existing().restaurantId, 'captain')
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
        staffHasScreen(resource.data.restaurantId, 'cashier') ||
        staffHasScreen(resource.data.restaurantId, 'captain');
      allow create: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
          staffHasScreen(existing().restaurantId, 'cashier') ||
          staffHasScreen(existing().restaurantId, 'captain')
        ) &&
        existing().status != 'resolved' && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'handledByUid', 'handledByName', 'handledByRole', 'updatedAt'
          ])
        ) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == existing().ownerId;
      allow delete: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 8. Halls / Dining Zones collection (zero-PII public lookup + owner or 'halls' staff write)
    match /halls/{hallId} {
      allow get: if isValidId(hallId);
      allow list: if true;
      allow create: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
          (
            isVerifiedAccount() &&
            incoming().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
          ) || (
            staffHasScreen(incoming().restaurantId, 'halls') &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
          ) || (
            isSuperAdmin() &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
          )
        );
      allow update: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'name_en', 'tableCount', 'sortOrder', 'updatedAt'
        ]) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          isSuperAdmin() || (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          ) || staffHasScreen(existing().restaurantId, 'halls')
        );
      allow delete: if isValidId(hallId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        ) || staffHasScreen(existing().restaurantId, 'halls')
      );
    }

    // 9. Platform Settings CMS collection (public read for landing page, Super Admin write)
    match /platform_settings/{settingId} {
      allow get: if settingId == 'landing';
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
        settingId == 'landing' &&
        isValidPlatformLanding(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 10. Custom Injected Themes collection (public read, Super Admin write only)
    match /custom_themes/{themeId} {
      allow get: if isValidId(themeId);
      allow list: if isSuperAdmin() || resource.data.isActive == true;
      allow create: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().createdAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isActive']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'name_en', 'description', 'description_en', 'previewImage', 'htmlCode', 'cssCode', 'jsCode', 'isActive'
          ])
        );
      allow delete: if isSuperAdmin() && isValidId(themeId);
    }

    // 11. Platform SaaS Promo Codes collection (Super Admin full CRUD; verified owners single-code get only)
    match /platform_promo_codes/{promoId} {
      allow get: if isVerifiedAccount() && isValidPromoCodeId(promoId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidPlatformPromoCode(incoming(), promoId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidPlatformPromoCode(incoming(), promoId) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidPromoCodeId(promoId);
    }
  }
}
