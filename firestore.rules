        (!('handedOverToRole' in data) || (data.handedOverToRole in ['', 'cashier', 'manager', 'owner'])) &&
        (!('handoverNote' in data) || (data.handoverNote is string && data.handoverNote.size() <= 300)) &&
        (!('handoverOpenTables' in data) || (data.handoverOpenTables is list && data.handoverOpenTables.size() <= 100)) &&
        (!('handoverStatus' in data) || (data.handoverStatus in ['none', 'handed_to_cashier', 'handed_to_manager', 'handed_to_owner', 'self_continued'])) &&
        (!('extendedHours' in data) || (data.extendedHours is number && data.extendedHours >= 0 && data.extendedHours <= 24)) &&
        (!('superAdminUnlocked' in data) || data.superAdminUnlocked is bool) &&
        data.startedAt is timestamp &&
        (!('endedAt' in data) || data.endedAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidDrawerExpenseShape(data, restaurantId, expenseId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'shiftId', 'cashierUid', 'cashierName', 'amount', 'description', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'shiftId', 'cashierUid', 'cashierName', 'amount', 'description', 'note', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == expenseId &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        isValidId(data.shiftId) &&
        isValidId(data.cashierUid) &&
        data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 100 &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        data.createdAt is timestamp;
    }

    function isValidTreasuryTransferShape(data, restaurantId, transferId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'fromType', 'toType', 'fromUid', 'fromName', 'toName', 'amountCash', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'fromType', 'toType', 'fromUid', 'fromName', 'toUid', 'toName',
          'shiftId', 'amountCash', 'amountVisa', 'note', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == transferId &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        data.fromType in ['cashier_shift', 'manager_custody', 'owner_adjustment'] &&
        data.toType in ['cashier_shift', 'manager_custody', 'owner_vault'] &&
        isValidId(data.fromUid) &&
        data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 100 &&
        (!('toUid' in data) || data.toUid == '' || isValidId(data.toUid)) &&
        data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 100 &&
        (!('shiftId' in data) || data.shiftId == '' || isValidId(data.shiftId)) &&
        data.amountCash is number && data.amountCash >= -1000000 && data.amountCash <= 100000000 &&
        (!('amountVisa' in data) || (data.amountVisa is number && data.amountVisa >= 0 && data.amountVisa <= 100000000)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 300)) &&
        data.createdAt is timestamp;
    }

    function isValidStaffDeviceShape(data, restaurantId, deviceId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'staffId', 'staffName', 'fcmToken',
          'deviceName', 'platform', 'activeStations', 'topics', 'isActive',
          'lastSeenAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'staffId', 'staffName', 'fcmToken',
          'deviceName', 'platform', 'activeStations', 'topics', 'isActive',
          'lastSeenAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == deviceId &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        isValidId(data.staffId) &&
        data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
        data.fcmToken is string && data.fcmToken.size() >= 1 && data.fcmToken.size() <= 500 &&
        data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120 &&
        data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64 &&
        data.activeStations is list && data.activeStations.size() <= 30 &&
        (data.activeStations.size() == 0 || isValidStation(data.activeStations[0])) &&
        data.topics is list && data.topics.size() <= 30 &&
        (data.topics.size() == 0 || (data.topics[0] is string && data.topics[0].size() <= 160)) &&
        data.isActive is bool &&
        data.lastSeenAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHallShape(data, hallId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'name', 'tableCount', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'name', 'name_en', 'hallType', 'tableCount', 'tableNumbers', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == hallId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 80)) &&
        (!('hallType' in data) || (data.hallType is string && data.hallType.size() <= 60)) &&
        data.tableCount is number && data.tableCount >= 1 && data.tableCount <= 200 &&
        (!('tableNumbers' in data) || (data.tableNumbers is list && data.tableNumbers.size() >= 1 && data.tableNumbers.size() <= 200 && data.tableNumbers[0] is string)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlatformLanding(data) {
      return data.keys().hasAll([
          'heroTitle', 'heroSubtitle', 'ctaButtonText', 'features',
          'pricingPlans', 'supportWhatsapp', 'footerText', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'sections', 'heroBadge', 'heroBadge_en',
          'heroTitle', 'heroTitle_en', 'heroSubtitle', 'heroSubtitle_en',
          'ctaButtonText', 'ctaButtonText_en', 'heroSecondaryBtnText', 'heroSecondaryBtnText_en',
          'themesTitle', 'themesTitle_en', 'themesSubtitle', 'themesSubtitle_en',
          'featuresTitle', 'featuresTitle_en', 'featuresSubtitle', 'featuresSubtitle_en', 'features',
          'operationsBadge', 'operationsBadge_en', 'operationsTitle', 'operationsTitle_en',
          'operationsSubtitle', 'operationsSubtitle_en', 'operationsBullets', 'operationsBullets_en',
          'loyaltyBadge', 'loyaltyBadge_en', 'loyaltyTitle', 'loyaltyTitle_en',
          'loyaltySubtitle', 'loyaltySubtitle_en', 'loyaltyBullets', 'loyaltyBullets_en',
          'pricingTitle', 'pricingTitle_en', 'pricingSubtitle', 'pricingSubtitle_en',
          'pricingCtaText', 'pricingCtaText_en', 'pricingPlans',
          'tygosBadge', 'tygosBadge_en', 'tygosTitle', 'tygosTitle_en',
          'tygosSubtitle', 'tygosSubtitle_en', 'tygosCtaText', 'tygosCtaText_en',
          'supportWhatsapp', 'footerText', 'footerText_en',
          'platformLogoUrl', 'shareTitle', 'shareTitle_en',
          'shareDescription', 'shareDescription_en', 'updatedAt'
        ]) &&
        (!('sections' in data) || (data.sections is list && data.sections.size() <= 10 && (data.sections.size() == 0 || data.sections[0] is map))) &&
        (!('heroBadge' in data) || (data.heroBadge is string && data.heroBadge.size() <= 120)) &&
        (!('heroBadge_en' in data) || (data.heroBadge_en is string && data.heroBadge_en.size() <= 120)) &&
        data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 200 &&
        (!('heroTitle_en' in data) || (data.heroTitle_en is string && data.heroTitle_en.size() <= 200)) &&
        data.heroSubtitle is string && data.heroSubtitle.size() >= 1 && data.heroSubtitle.size() <= 600 &&
        (!('heroSubtitle_en' in data) || (data.heroSubtitle_en is string && data.heroSubtitle_en.size() <= 600)) &&
        data.ctaButtonText is string && data.ctaButtonText.size() >= 1 && data.ctaButtonText.size() <= 80 &&
        (!('ctaButtonText_en' in data) || (data.ctaButtonText_en is string && data.ctaButtonText_en.size() <= 80)) &&
        (!('heroSecondaryBtnText' in data) || (data.heroSecondaryBtnText is string && data.heroSecondaryBtnText.size() <= 80)) &&
        (!('heroSecondaryBtnText_en' in data) || (data.heroSecondaryBtnText_en is string && data.heroSecondaryBtnText_en.size() <= 80)) &&
        (!('themesTitle' in data) || (data.themesTitle is string && data.themesTitle.size() <= 160)) &&
        (!('themesTitle_en' in data) || (data.themesTitle_en is string && data.themesTitle_en.size() <= 160)) &&
        (!('themesSubtitle' in data) || (data.themesSubtitle is string && data.themesSubtitle.size() <= 400)) &&
        (!('themesSubtitle_en' in data) || (data.themesSubtitle_en is string && data.themesSubtitle_en.size() <= 400)) &&
        (!('featuresTitle' in data) || (data.featuresTitle is string && data.featuresTitle.size() <= 160)) &&
        (!('featuresTitle_en' in data) || (data.featuresTitle_en is string && data.featuresTitle_en.size() <= 160)) &&
        (!('featuresSubtitle' in data) || (data.featuresSubtitle is string && data.featuresSubtitle.size() <= 400)) &&
        (!('featuresSubtitle_en' in data) || (data.featuresSubtitle_en is string && data.featuresSubtitle_en.size() <= 400)) &&
        data.features is list && data.features.size() <= 12 && (data.features.size() == 0 || data.features[0] is map) &&
        (!('operationsBadge' in data) || (data.operationsBadge is string && data.operationsBadge.size() <= 120)) &&
        (!('operationsBadge_en' in data) || (data.operationsBadge_en is string && data.operationsBadge_en.size() <= 120)) &&
        (!('operationsTitle' in data) || (data.operationsTitle is string && data.operationsTitle.size() <= 200)) &&
        (!('operationsTitle_en' in data) || (data.operationsTitle_en is string && data.operationsTitle_en.size() <= 200)) &&
        (!('operationsSubtitle' in data) || (data.operationsSubtitle is string && data.operationsSubtitle.size() <= 500)) &&
        (!('operationsSubtitle_en' in data) || (data.operationsSubtitle_en is string && data.operationsSubtitle_en.size() <= 500)) &&
        (!('operationsBullets' in data) || (data.operationsBullets is list && data.operationsBullets.size() <= 8 && (data.operationsBullets.size() == 0 || data.operationsBullets[0] is string))) &&
        (!('operationsBullets_en' in data) || (data.operationsBullets_en is list && data.operationsBullets_en.size() <= 8 && (data.operationsBullets_en.size() == 0 || data.operationsBullets_en[0] is string))) &&
        (!('loyaltyBadge' in data) || (data.loyaltyBadge is string && data.loyaltyBadge.size() <= 120)) &&
        (!('loyaltyBadge_en' in data) || (data.loyaltyBadge_en is string && data.loyaltyBadge_en.size() <= 120)) &&
        (!('loyaltyTitle' in data) || (data.loyaltyTitle is string && data.loyaltyTitle.size() <= 200)) &&
        (!('loyaltyTitle_en' in data) || (data.loyaltyTitle_en is string && data.loyaltyTitle_en.size() <= 200)) &&
        (!('loyaltySubtitle' in data) || (data.loyaltySubtitle is string && data.loyaltySubtitle.size() <= 500)) &&
        (!('loyaltySubtitle_en' in data) || (data.loyaltySubtitle_en is string && data.loyaltySubtitle_en.size() <= 500)) &&
        (!('loyaltyBullets' in data) || (data.loyaltyBullets is list && data.loyaltyBullets.size() <= 8 && (data.loyaltyBullets.size() == 0 || data.loyaltyBullets[0] is string))) &&
        (!('loyaltyBullets_en' in data) || (data.loyaltyBullets_en is list && data.loyaltyBullets_en.size() <= 8 && (data.loyaltyBullets_en.size() == 0 || data.loyaltyBullets_en[0] is string))) &&
        (!('pricingTitle' in data) || (data.pricingTitle is string && data.pricingTitle.size() <= 160)) &&
        (!('pricingTitle_en' in data) || (data.pricingTitle_en is string && data.pricingTitle_en.size() <= 160)) &&
        (!('pricingSubtitle' in data) || (data.pricingSubtitle is string && data.pricingSubtitle.size() <= 400)) &&
        (!('pricingSubtitle_en' in data) || (data.pricingSubtitle_en is string && data.pricingSubtitle_en.size() <= 400)) &&
        (!('pricingCtaText' in data) || (data.pricingCtaText is string && data.pricingCtaText.size() <= 80)) &&
        (!('pricingCtaText_en' in data) || (data.pricingCtaText_en is string && data.pricingCtaText_en.size() <= 80)) &&
        data.pricingPlans is list && data.pricingPlans.size() <= 6 && (data.pricingPlans.size() == 0 || data.pricingPlans[0] is map) &&
        (!('tygosBadge' in data) || (data.tygosBadge is string && data.tygosBadge.size() <= 120)) &&
        (!('tygosBadge_en' in data) || (data.tygosBadge_en is string && data.tygosBadge_en.size() <= 120)) &&
        (!('tygosTitle' in data) || (data.tygosTitle is string && data.tygosTitle.size() <= 200)) &&
        (!('tygosTitle_en' in data) || (data.tygosTitle_en is string && data.tygosTitle_en.size() <= 200)) &&
        (!('tygosSubtitle' in data) || (data.tygosSubtitle is string && data.tygosSubtitle.size() <= 500)) &&
        (!('tygosSubtitle_en' in data) || (data.tygosSubtitle_en is string && data.tygosSubtitle_en.size() <= 500)) &&
        (!('tygosCtaText' in data) || (data.tygosCtaText is string && data.tygosCtaText.size() <= 80)) &&
        (!('tygosCtaText_en' in data) || (data.tygosCtaText_en is string && data.tygosCtaText_en.size() <= 80)) &&
        data.supportWhatsapp is string && data.supportWhatsapp.size() <= 32 &&
        data.footerText is string && data.footerText.size() >= 1 && data.footerText.size() <= 200 &&
        (!('footerText_en' in data) || (data.footerText_en is string && data.footerText_en.size() <= 200)) &&
        (!('platformLogoUrl' in data) || (data.platformLogoUrl is string && data.platformLogoUrl.size() <= 300000)) &&
        (!('shareTitle' in data) || (data.shareTitle is string && data.shareTitle.size() <= 140)) &&
        (!('shareTitle_en' in data) || (data.shareTitle_en is string && data.shareTitle_en.size() <= 140)) &&
        (!('shareDescription' in data) || (data.shareDescription is string && data.shareDescription.size() <= 300)) &&
        (!('shareDescription_en' in data) || (data.shareDescription_en is string && data.shareDescription_en.size() <= 300)) &&
        data.updatedAt is timestamp;
    }

    function isValidUiScreenConfig(scr) {
      return scr is map &&
        scr.keys().hasAll(['themeId', 'layoutStyle', 'cardRadius', 'cards', 'buttonOverrides']) &&
        scr.keys().hasOnly(['themeId', 'layoutStyle', 'cardRadius', 'accentColorOverride', 'cards', 'buttonOverrides']) &&
        scr.themeId in [
          'sand_sapphire', 'obsidian_gold', 'alabaster_editorial', 'emerald_hospitality', 'midnight_sapphire',
          'espresso_bistro', 'nordic_slate', 'burgundy_velvet', 'saffron_sunrise'
        ] &&
        scr.layoutStyle in ['sidebar_cards', 'compact_rail', 'top_deck'] &&
        scr.cardRadius in ['sharp', 'rounded', 'soft'] &&
        (!('accentColorOverride' in scr) || (scr.accentColorOverride is string && scr.accentColorOverride.matches('^#[0-9a-fA-F]{6}$'))) &&
        scr.cards is list && scr.cards.size() >= 1 && scr.cards.size() <= 12 && scr.cards[0] is map &&
        scr.buttonOverrides is map && scr.buttonOverrides.keys().size() <= 24;
    }

    function isValidPlatformUiConfig(data) {
      return data.keys().hasAll([
          'id', 'version', 'publishedBy', 'refreshNoticeAr', 'refreshNoticeEn', 'screens', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'version', 'publishedBy', 'refreshNoticeAr', 'refreshNoticeEn', 'screens', 'updatedAt'
        ]) &&
        data.id == 'ui_config' &&
        data.version is number && data.version >= 1 && data.version <= 1000000 &&
        data.publishedBy is string && data.publishedBy.size() >= 3 && data.publishedBy.size() <= 128 &&
        data.refreshNoticeAr is string && data.refreshNoticeAr.size() >= 1 && data.refreshNoticeAr.size() <= 300 &&
        data.refreshNoticeEn is string && data.refreshNoticeEn.size() >= 1 && data.refreshNoticeEn.size() <= 300 &&
        data.screens is map &&
        data.screens.keys().hasAll(['super_admin', 'owner_admin', 'manager_console', 'cashier_kds', 'captain_waiter', 'landing_page']) &&
        data.screens.keys().hasOnly(['super_admin', 'owner_admin', 'manager_console', 'cashier_kds', 'captain_waiter', 'landing_page']) &&
        isValidUiScreenConfig(data.screens.super_admin) &&
        isValidUiScreenConfig(data.screens.owner_admin) &&
        isValidUiScreenConfig(data.screens.manager_console) &&
        isValidUiScreenConfig(data.screens.cashier_kds) &&
        isValidUiScreenConfig(data.screens.captain_waiter) &&
        isValidUiScreenConfig(data.screens.landing_page) &&
        data.updatedAt is timestamp;
    }

    function isValidPromoCodeId(promoId) {
      return promoId is string && promoId.size() >= 2 && promoId.size() <= 32 && promoId.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidPlatformPromoCode(data, promoId) {
      return data.keys().hasAll([
          'id', 'code', 'discountType', 'discountValue', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'discountType', 'discountValue', 'description', 'description_en', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        isValidPromoCodeId(promoId) &&
        data.id == promoId &&
        data.code == promoId &&
        data.discountType in ['percent', 'fixed', 'free_month'] &&
        data.discountValue is number && data.discountValue >= 0 && data.discountValue <= 100000 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 200)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 200)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomTheme(data, themeId) {
      return data.keys().hasAll([
          'id', 'name', 'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'name_en', 'description', 'description_en', 'previewImage',
          'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == themeId &&
        data.id.matches('^custom_[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 400)) &&
        (!('previewImage' in data) || (data.previewImage is string && data.previewImage.size() <= 300000)) &&
        data.htmlCode is string && data.htmlCode.size() <= 150000 &&
        data.cssCode is string && data.cssCode.size() <= 100000 &&
        data.jsCode is string && data.jsCode.size() <= 100000 &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    // 1. Users collection (owner-only PII + Super Admin read)
    match /users/{userId} {
      allow get: if isSuperAdmin() || (isVerifiedAccount() && isValidId(userId) && request.auth.uid == userId);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 2. Slugs lookup collection
    match /slugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().createdAt == request.time;
      allow update: if isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['restaurantId']) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      allow delete: if isValidSlug(slug) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 3. Restaurants collection
    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId);
      allow list: if isSuperAdmin() || (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedAccount() && isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid && (
              incoming().diff(existing()).affectedKeys().hasOnly(['activeTheme', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['operationsConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['treasuryState', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['operationsConfig', 'treasuryState', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'ownerBirthday', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ]) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'appliedPlatformPromoCode', 'appliedPlatformPromoSummary', 'appliedPlatformPromoSummary_en', 'updatedAt'
                ]) &&
                isValidPromoCodeId(incoming().appliedPlatformPromoCode) &&
                exists(/databases/$(database)/documents/platform_promo_codes/$(incoming().appliedPlatformPromoCode)) &&
                get(/databases/$(database)/documents/platform_promo_codes/$(incoming().appliedPlatformPromoCode)).data.isActive == true
              )
            )
          ) || (
            isActiveManagerForRestaurant(restaurantId) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['operationsConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['treasuryState', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['operationsConfig', 'treasuryState', 'updatedAt'])
            )
          ) || (
            staffHasScreen(restaurantId, 'cashier') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['treasuryState', 'updatedAt'])
          ) || (
            isSuperAdmin() && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isSuspended', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['operationsConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['treasuryState', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'loyaltyConfig', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'isSuspended', 'ownerBirthday', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'appliedPlatformPromoCode', 'appliedPlatformPromoSummary', 'appliedPlatformPromoSummary_en', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isValidId(restaurantId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );

      // 3b. Table Sessions subcollection (Live Group Cart per dining table)
      match /table_sessions/{sessionId} {
        allow get: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid)
        );
        allow create: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId;
        allow update: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && (
            (
              existing().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              existing().status == 'closed' &&
              incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              (
                isSuperAdmin() ||
                (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
                staffHasScreen(restaurantId, 'cashier') ||
                staffHasScreen(restaurantId, 'captain')
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'lastOrderNumber', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(sessionId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
          staffHasScreen(restaurantId, 'cashier')
        );
      }

      // 3c. Customers Loyalty & Personalization subcollection (keyed by phone)
      match /customers/{customerPhone} {
        allow get: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
          staffHasScreen(restaurantId, 'captain') ||
          staffHasScreen(restaurantId, 'cashier')
        );
        allow create: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          isValidCustomerShape(incoming(), restaurantId, customerPhone) &&
          incoming().totalOrders == 0 &&
          incoming().loyaltyCycleOrders == 0 &&
          incoming().firstOrderDiscountUsed == false &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId;
        allow update: if isValidId(restaurantId) &&
          isValidPhoneId(customerPhone) &&
          isValidCustomerShape(incoming(), restaurantId, customerPhone) &&
          incoming().id == existing().id &&
          incoming().phone == existing().phone &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (existing().firstOrderDiscountUsed == false || incoming().firstOrderDiscountUsed == true) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && (
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'birthDay', 'birthMonth', 'birthYear', 'preferredOrderType', 'address', 'updatedAt'
              ])
            ) || (
              incoming().totalOrders >= existing().totalOrders &&
              incoming().totalOrders <= existing().totalOrders + 1 &&
              incoming().lastVisitAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'fullName', 'preferredOrderType', 'address',
                'totalOrders', 'loyaltyCycleOrders', 'firstOrderDiscountUsed',
                'lastVisitAt', 'favoriteItems', 'lastOrderItems', 'updatedAt'
              ])
            ) || (
              isSuperAdmin() ||
              (isVerifiedAccount() && existing().ownerId == request.auth.uid)
            )
          );
        allow delete: if isValidId(restaurantId) && isValidPhoneId(customerPhone) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      }

      // 3d. Staff Members subcollection (Strictly Owner, Manager, or self-get; NEVER non-manager list!)
      match /staff/{staffUid} {
        allow get: if isValidId(restaurantId) && isValidId(staffUid) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && request.auth.uid == staffUid && existing().restaurantId == restaurantId)
        );
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(staffUid) &&
          isValidStaffMemberShape(incoming(), restaurantId, staffUid) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              incoming().createdBy == request.auth.uid &&
              incoming().role != 'manager' &&
              !('staff_management' in incoming().allowedScreens)
            )
          );
        allow update: if isValidId(restaurantId) && isValidId(staffUid) &&
          isValidStaffMemberShape(incoming(), restaurantId, staffUid) &&
          incoming().uid == existing().uid &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().username == existing().username &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              // Self one-time QR onboarding activation (checked first to avoid owner/manager reads)
              isSignedIn() &&
              request.auth.uid == staffUid &&
              existing().mustChangePassword == true &&
              existing().activeInviteHash != '' &&
              exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_invites/$(existing().activeInviteHash)) &&
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/staff_invites/$(existing().activeInviteHash)).data.staffId == request.auth.uid &&
              incoming().role == existing().role &&
              incoming().allowedScreens == existing().allowedScreens &&
              incoming().defaultScreen == existing().defaultScreen &&
              incoming().isActive == true &&
              incoming().mustChangePassword == false &&
              incoming().passwordChangedAt == request.time &&
              incoming().lastLoginAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'phone', 'email', 'jobTitle', 'hallId', 'hallName',
                'isActive', 'mustChangePassword', 'passwordChangedAt', 'lastLoginAt', 'updatedAt'
              ])
            ) || (
              // Auto-lift expired timed suspension upon staff re-login
              isSignedIn() &&
              request.auth.uid == staffUid &&
              existing().isActive == false &&
              existing().suspendedType == 'timed' &&
              existing().suspendedUntil != null &&
              existing().suspendedUntil <= request.time &&
              incoming().isActive == true &&
              incoming().suspendedType == '' &&
              incoming().suspendedUntil == null &&
              incoming().suspendedReason == '' &&
              incoming().lastLoginAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'isActive', 'suspendedType', 'suspendedUntil', 'suspendedReason',
                'suspendedByRole', 'suspendedByName', 'lastLoginAt', 'updatedAt'
              ])
            ) || (
              // Active employee login timestamp or forced password update
              isSignedIn() &&
              request.auth.uid == staffUid &&
              existing().isActive == true && (
                (
                  incoming().lastLoginAt == request.time &&
                  incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt'])
                ) || (
                  incoming().mustChangePassword == false &&
                  incoming().passwordChangedAt == request.time &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'mustChangePassword', 'passwordChangedAt', 'updatedAt'
                  ])
                )
              )
            ) ||
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              (existing().role != 'manager' || request.auth.uid == staffUid) &&
              (existing().role == 'manager' ? incoming().role == 'manager' : incoming().role != 'manager') &&
              (existing().role == 'manager' || !('staff_management' in incoming().allowedScreens))
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(staffUid) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          (isActiveManagerForRestaurant(restaurantId) && existing().role != 'manager')
        );
      }

      // 3e. One-Time Staff QR Invites (hashed tokenId = inviteId; single-use 24h activation)
      match /staff_invites/{inviteId} {
        allow get: if isValidId(restaurantId) && isValidId(inviteId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(inviteId) &&
          isValidStaffInviteShape(incoming(), restaurantId, inviteId) &&
          !('usedAt' in incoming()) &&
          !('revokedAt' in incoming()) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (
              isActiveManagerForRestaurant(restaurantId) &&
              incoming().createdBy == request.auth.uid &&
              incoming().staffRole != 'manager' &&
              !('staff_management' in incoming().allowedScreens)
            )
          );
        allow update: if isValidId(restaurantId) && isValidId(inviteId) &&
          isValidStaffInviteShape(incoming(), restaurantId, inviteId) &&
          incoming().id == existing().id &&
          incoming().staffId == existing().staffId &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().tokenHash == existing().tokenHash &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              // Self one-time invite redemption (0 reads short-circuit)
              isSignedIn() &&
              request.auth.uid == existing().staffId &&
              !('usedAt' in existing()) &&
              !('revokedAt' in existing()) &&
              existing().expiresAt > request.time &&
              incoming().usedAt == request.time &&
              incoming().usedByUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['usedAt', 'usedByUid', 'updatedAt'])
            ) ||
            isSuperAdmin() ||
            (
              (isOwnerOfRestaurant(restaurantId) || (isActiveManagerForRestaurant(restaurantId) && existing().staffRole != 'manager')) &&
              incoming().revokedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['revokedAt', 'updatedAt'])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(inviteId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId)
        );
      }

      // 3f. Pre-auth hashed Login Lookup Index (get only for identifier resolution; NO public list!)
      match /staff_login_index/{lookupId} {
        allow get: if isValidId(restaurantId) && isValidId(lookupId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(lookupId) &&
          isValidStaffLoginIndexShape(incoming(), restaurantId, lookupId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            (
              isSignedIn() &&
              incoming().staffUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(request.auth.uid)).data.isActive == true
            ) ||
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId)
          );
        allow update: if isValidId(restaurantId) && isValidId(lookupId) &&
          isValidStaffLoginIndexShape(incoming(), restaurantId, lookupId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            (
              // Self activation update (0 reads short-circuit)
              isSignedIn() &&
              existing().staffUid == request.auth.uid &&
              incoming().staffUid == request.auth.uid &&
              incoming().authEmail == existing().authEmail &&
              incoming().isActive == true &&
              incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt'])
            ) ||
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId)
          );
        allow delete: if isValidId(restaurantId) && isValidId(lookupId) && (
          (isSignedIn() && existing().staffUid == request.auth.uid) ||
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
      }

      // 3g. Immutable Staff Accountability & Security Audit Logs
      match /staff_audit_logs/{logId} {
        allow get, list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId)
        );
        allow create: if isValidId(restaurantId) && isValidId(logId) &&
          isValidStaffAuditLogShape(incoming(), restaurantId, logId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().actorUid == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().actorUid == request.auth.uid) ||
            (
              isSignedIn() &&
              incoming().actorUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/staff_access/$(request.auth.uid)).data.restaurantId == restaurantId &&
              getAfter(/databases/$(database)/documents/staff_access/$(request.auth.uid)).data.isActive == true
            )
          );
        allow update: if false;
        allow delete: if isValidId(restaurantId) && isValidId(logId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId)
        );
      }

      // 3g-2. Dynamic Unlimited Kitchen / Prep Stations & Captain Screens subcollection
      match /stations/{stationId} {
        allow get: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if true;
        allow create: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          isValidStationShape(incoming(), restaurantId, stationId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().createdBy == request.auth.uid) ||
            (managerHasStationsPermission(restaurantId) && incoming().createdBy == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidStation(stationId) &&
          isValidStationShape(incoming(), restaurantId, stationId) &&
          incoming().id == existing().id &&
          incoming().stationId == existing().stationId &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'nameEn', 'color', 'icon', 'screenType',
            'isActive', 'isArchived', 'isDefaultFallback', 'showPrices',
            'allowedOrderTypes', 'soundAlertEnabled', 'overdueAlertMinutes',
            'thermalPrintMode', 'availableStatusButtons', 'assignedHallIds',
            'assignedTableNumbers', 'tableVisibilityScope',
            'sortOrder', 'updatedAt'
          ]) && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            managerHasStationsPermission(restaurantId)
          );
        allow delete: if isValidId(restaurantId) && isValidStation(stationId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          managerHasStationsPermission(restaurantId)
        );
      }

      // 3g-3. Operational Staff Shifts subcollection (active shift tracking & uncovered station alerts)
      match /staff_shifts/{shiftId} {
        allow get: if isValidId(restaurantId) && isValidId(shiftId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveStaffForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
        allow list: if isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
          isActiveStaffForRestaurant(restaurantId) ||
          (isSignedIn() && resource.data.staffId == request.auth.uid);
        allow create: if isValidId(restaurantId) &&
          isValidId(shiftId) &&
          isValidStaffShiftShape(incoming(), restaurantId, shiftId) &&
          incoming().status == 'active' &&
          incoming().ordersHandled == 0 &&
          incoming().itemsMarkedReady == 0 &&
          incoming().serviceCallsHandled == 0 &&
          incoming().startedAt == request.time &&
          incoming().updatedAt == request.time &&
          !('endedAt' in incoming()) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().staffId == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidId(shiftId) &&
          isValidStaffShiftShape(incoming(), restaurantId, shiftId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().staffId == existing().staffId &&
          incoming().stationId == existing().stationId &&
          incoming().startedAt == existing().startedAt &&
          incoming().updatedAt == request.time && (
            (
              // Super Admin override ONLY for closed shifts
              isSuperAdmin()
            ) || (
              // Closing an active shift with handover details
              existing().status == 'active' &&
              incoming().status == 'completed' &&
              incoming().endedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'endedAt', 'updatedAt',
                'cashSales', 'visaSales', 'drawerExpensesTotal', 'drawerVarianceTotal', 'expectedCashHandover',
                'handedOverToUid', 'handedOverToName', 'handedOverToRole', 'handoverNote',
                'handoverOpenTables', 'handoverStatus', 'extendedHours'
              ]) && (
                isOwnerOfRestaurant(restaurantId) ||
                isActiveManagerForRestaurant(restaurantId) ||
                (isActiveStaffForRestaurant(restaurantId) && existing().staffId == request.auth.uid)
              )
            ) || (
              // Owner or Manager adjusting cashier float or shift slot on active shift
              existing().status == 'active' &&
              incoming().status == 'active' &&
              (isOwnerOfRestaurant(restaurantId) || isActiveManagerForRestaurant(restaurantId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'openingFloat', 'extendedHours', 'shiftSlotId', 'shiftSlotName', 'updatedAt'
              ])
            ) || (
              // Active shift operational & financial counters
              existing().status == 'active' &&
              incoming().status == 'active' &&
              isActiveStaffForRestaurant(restaurantId) && (
                (
                  existing().staffId == request.auth.uid && (
                    (
                      incoming().diff(existing()).affectedKeys().hasOnly(['ordersHandled', 'updatedAt']) &&
                      incoming().ordersHandled >= existing().ordersHandled &&
                      incoming().ordersHandled <= existing().ordersHandled + 50
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly(['itemsMarkedReady', 'updatedAt']) &&
                      incoming().itemsMarkedReady >= existing().itemsMarkedReady &&
                      incoming().itemsMarkedReady <= existing().itemsMarkedReady + 50
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly(['serviceCallsHandled', 'updatedAt']) &&
                      incoming().serviceCallsHandled >= existing().serviceCallsHandled &&
                      incoming().serviceCallsHandled <= existing().serviceCallsHandled + 50
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly(['extendedHours', 'updatedAt'])
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'ordersHandled', 'cashSales', 'visaSales', 'drawerVarianceTotal', 'expectedCashHandover', 'updatedAt'
                      ])
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'cashSales', 'visaSales', 'drawerVarianceTotal', 'expectedCashHandover', 'updatedAt'
                      ])
                    ) || (
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'drawerExpensesTotal', 'expectedCashHandover', 'updatedAt'
                      ])
                    )
                  )
                ) || (
                  // Owner or Manager acting inside an active shift (e.g. closing an order on Cashier)
                  (isOwnerOfRestaurant(restaurantId) || isActiveManagerForRestaurant(restaurantId)) &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'ordersHandled', 'cashSales', 'visaSales', 'drawerVarianceTotal', 'expectedCashHandover', 'updatedAt'
                  ])
                )
              )
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(shiftId) && (
          isSuperAdmin() ||
          (isOwnerOfRestaurant(restaurantId) && existing().status == 'active')
        );
      }

      // 3g-4. Registered Staff PWA Devices & FCM Topic Registrations
      match /staff_devices/{deviceId} {
        allow get: if isValidId(restaurantId) && isValidId(deviceId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
        allow list: if isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && resource.data.staffId == request.auth.uid);
        allow create: if isValidId(restaurantId) &&
          isValidId(deviceId) &&
          isValidStaffDeviceShape(incoming(), restaurantId, deviceId) &&
          incoming().lastSeenAt == request.time &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            (isOwnerOfRestaurant(restaurantId) && incoming().staffId == request.auth.uid) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow update: if isValidId(restaurantId) &&
          isValidId(deviceId) &&
          isValidStaffDeviceShape(incoming(), restaurantId, deviceId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'staffId', 'staffName', 'fcmToken', 'deviceName', 'platform',
            'activeStations', 'topics', 'isActive', 'lastSeenAt', 'updatedAt'
          ]) && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (isActiveStaffForRestaurant(restaurantId) && incoming().staffId == request.auth.uid)
          );
        allow delete: if isValidId(restaurantId) && isValidId(deviceId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          (isSignedIn() && existing().staffId == request.auth.uid)
        );
      }

      // 3g-5. Cashier Shift Drawer Expenses subcollection (immutable once recorded)
      match /drawer_expenses/{expenseId} {
        allow get, list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          staffHasScreen(restaurantId, 'cashier')
        );
        allow create: if isValidId(restaurantId) &&
          isValidId(expenseId) &&
          isValidDrawerExpenseShape(incoming(), restaurantId, expenseId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (staffHasScreen(restaurantId, 'cashier') && incoming().cashierUid == request.auth.uid)
          );
        allow update: if false;
        allow delete: if isSuperAdmin();
      }

      // 3g-6. Treasury Transfers & Handovers subcollection (immutable once recorded)
      match /treasury_transfers/{transferId} {
        allow get, list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(restaurantId) ||
          isActiveManagerForRestaurant(restaurantId) ||
          staffHasScreen(restaurantId, 'cashier')
        );
        allow create: if isValidId(restaurantId) &&
          isValidId(transferId) &&
          isValidTreasuryTransferShape(incoming(), restaurantId, transferId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId && (
            isSuperAdmin() ||
            isOwnerOfRestaurant(restaurantId) ||
            isActiveManagerForRestaurant(restaurantId) ||
            (staffHasScreen(restaurantId, 'cashier') && incoming().fromUid == request.auth.uid)
          );
        allow update: if false;
        allow delete: if isSuperAdmin();
      }
    }

    // 3h. Top-level Staff RBAC Access Map (indexed strictly by staffUid for fast cross-collection rules)
    match /staff_access/{staffUid} {
      allow get: if isValidId(staffUid) && (
        isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == staffUid) ||
        isOwnerOfRestaurant(existing().restaurantId) ||
        isActiveManagerForRestaurant(existing().restaurantId)
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(staffUid) &&
        isValidStaffAccessShape(incoming(), staffUid) &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          isOwnerOfRestaurant(incoming().restaurantId) ||
          (
            isActiveManagerForRestaurant(incoming().restaurantId) &&
            incoming().role != 'manager' &&
            !('staff_management' in incoming().allowedScreens)
          )
        );
      allow update: if isValidId(staffUid) &&
        isValidStaffAccessShape(incoming(), staffUid) &&
        incoming().uid == existing().uid &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time && (
          (
            // Auto-lift expired timed suspension upon staff re-login
            isSignedIn() &&
            request.auth.uid == staffUid &&
            existing().isActive == false &&
            existing().suspendedType == 'timed' &&
            existing().suspendedUntil != null &&
            existing().suspendedUntil <= request.time &&
            incoming().role == existing().role &&
            incoming().allowedScreens == existing().allowedScreens &&
            incoming().defaultScreen == existing().defaultScreen &&
            incoming().isActive == true &&
            incoming().suspendedType == '' &&
            incoming().suspendedUntil == null &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isActive', 'suspendedType', 'suspendedUntil', 'updatedAt'
            ])
          ) || (
            isSignedIn() &&
            request.auth.uid == staffUid &&
            existing().mustChangePassword == true &&
            incoming().role == existing().role &&
            incoming().allowedScreens == existing().allowedScreens &&
            incoming().defaultScreen == existing().defaultScreen &&
            incoming().isActive == true &&
            incoming().mustChangePassword == false &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hallId', 'isActive', 'mustChangePassword', 'updatedAt'
            ])
          ) || (
            isSignedIn() &&
            request.auth.uid == staffUid &&
            existing().isActive == true &&
            incoming().role == existing().role &&
            incoming().allowedScreens == existing().allowedScreens &&
            incoming().defaultScreen == existing().defaultScreen &&
            incoming().mustChangePassword == false &&
            incoming().diff(existing()).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
          ) ||
          isSuperAdmin() ||
          isOwnerOfRestaurant(existing().restaurantId) ||
          (
            isActiveManagerForRestaurant(existing().restaurantId) &&
            (existing().role != 'manager' || request.auth.uid == staffUid) &&
            (existing().role == 'manager' ? incoming().role == 'manager' : incoming().role != 'manager') &&
            (existing().role == 'manager' || !('staff_management' in incoming().allowedScreens))
          )
        );
      allow delete: if isValidId(staffUid) && (
        isSuperAdmin() ||
        isOwnerOfRestaurant(existing().restaurantId) ||
        (isActiveManagerForRestaurant(existing().restaurantId) && existing().role != 'manager')
      );
    }

    // 4. Categories collection (linked by restaurantId)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().createdAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isActiveManagerForRestaurant(incoming().restaurantId) &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'parentId', 'name', 'name_en', 'imageUrl', 'station', 'stationId', 'stationIds', 'sortOrder'
        ]) && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          ) ||
          isActiveManagerForRestaurant(existing().restaurantId) ||
          isSuperAdmin()
        );
      allow delete: if isValidId(categoryId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        ) || isActiveManagerForRestaurant(existing().restaurantId)
      );
    }

    // 5. Menu Items collection (linked by restaurantId and categoryId)
    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isActiveManagerForRestaurant(incoming().restaurantId) &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          (
            (
              isSuperAdmin() ||
              isActiveManagerForRestaurant(existing().restaurantId) || (
                isVerifiedAccount() &&
                existing().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
              )
            ) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isAvailable', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['sortOrder', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'stationId', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'stationId', 'stationIds', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'categoryId', 'name', 'name_en', 'description', 'description_en', 'basePrice', 'imageUrl', 'calories',
                'isSpicy', 'isAvailable', 'ordersCount', 'sizes', 'addons', 'badge', 'isBogo', 'suggestedItemIds',
                'station', 'stationId', 'stationIds', 'sortOrder', 'updatedAt'
              ])
            )
          ) || (
            incoming().categoryId == existing().categoryId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ordersCount', 'updatedAt']) &&
            incoming().ordersCount > existing().ordersCount &&
            incoming().ordersCount <= existing().ordersCount + 50
          )
        );
      allow delete: if isValidId(itemId) && (
        isSuperAdmin() ||
        isActiveManagerForRestaurant(existing().restaurantId) || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 6. Orders collection (strict isolation: Super Admin, Restaurant Owner, or Staff with matching screen)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
        isActiveManagerForRestaurant(existing().restaurantId) ||
        staffHasAnyOrderScreen(existing().restaurantId)
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
        isActiveManagerForRestaurant(resource.data.restaurantId) ||
        staffHasAnyOrderScreen(resource.data.restaurantId);
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          (
            // Closed / cancelled orders are IMMUTABLE except via Super Admin or explicit SuperAdmin unlock or while linked shift is still active (Owner/Manager)
            (existing().status in ['completed', 'cancelled']) && (
              isSuperAdmin() ||
              (
                (
                  existing().superAdminUnlocked == true ||
                  (
                    'shiftId' in existing() &&
                    existing().shiftId != '' &&
                    exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)/staff_shifts/$(existing().shiftId)) &&
                    get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)/staff_shifts/$(existing().shiftId)).data.status == 'active'
                  )
                ) && (
                  (
                    isVerifiedAccount() &&
                    existing().ownerId == request.auth.uid &&
                    get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
                  ) ||
                  isActiveManagerForRestaurant(existing().restaurantId)
                )
              )
            )
          ) || (
            // Open orders (pending / preparing)
            !(existing().status in ['completed', 'cancelled']) && (
              (
                (
                  isSuperAdmin() ||
                  (
                    isVerifiedAccount() &&
                    existing().ownerId == request.auth.uid &&
                    get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
                  ) ||
                  isActiveManagerForRestaurant(existing().restaurantId) ||
                  staffHasScreen(existing().restaurantId, 'cashier')
                ) && (
                  incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'closedByUid', 'closedByName', 'closedByRole', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'shiftId', 'paymentMethod', 'cashPaidAmount', 'visaPaidAmount',
                    'customerCashTendered', 'changeReturned', 'drawerVariance', 'closedAt',
                    'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole',
                    'closedByUid', 'closedByName', 'closedByRole', 'updatedAt'
                  ]) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'status', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
                  (
                    (
                      isSuperAdmin() ||
                      (
                        isVerifiedAccount() &&
                        existing().ownerId == request.auth.uid &&
                        get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
                      ) ||
                      isActiveManagerForRestaurant(existing().restaurantId)
                    ) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'items', 'subtotal', 'serviceCharge', 'deliveryFee', 'discountAmount',
                      'manualDiscountAmount', 'manualDiscountPercent', 'manualDiscountReason',
                      'taxAmount', 'total', 'notes', 'tableNotes', 'cancelReason',
                      'adjustmentHistory', 'status', 'shiftId', 'closedAt',
                      'closedByUid', 'closedByName', 'closedByRole',
                      'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt'
                    ])
                  )
                )
              ) || (
                (
                  staffHasAnyStationAccess(existing().restaurantId) ||
                  staffHasScreen(existing().restaurantId, 'captain')
                ) &&
                !(incoming().status in ['completed', 'cancelled']) && (
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'status', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt']) ||
                  incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'itemProgressBy', 'status', 'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole', 'updatedAt'])
                )
              )
            )
          )
        );
      allow delete: if isSuperAdmin() && isValidId(orderId);
    }

    // 7. Service Calls collection (Captain / Cashier / Owner / Super Admin ONLY; Kitchen/Bar/Pastry isolated!)
    match /service_calls/{callId} {
      allow get: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
        staffHasScreen(existing().restaurantId, 'cashier') ||
        staffHasScreen(existing().restaurantId, 'captain')
      );
      allow list: if isSuperAdmin() ||
        (isVerifiedAccount() && resource.data.ownerId == request.auth.uid) ||
        staffHasScreen(resource.data.restaurantId, 'cashier') ||
        staffHasScreen(resource.data.restaurantId, 'captain');
      allow create: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid) ||
          staffHasScreen(existing().restaurantId, 'cashier') ||
          staffHasScreen(existing().restaurantId, 'captain')
        ) &&
        existing().status != 'resolved' && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'handledByUid', 'handledByName', 'handledByRole', 'updatedAt'
          ])
        ) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == existing().ownerId;
      allow delete: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 8. Halls / Dining Zones collection (zero-PII public lookup + owner or permitted manager write only)
    match /halls/{hallId} {
      allow get: if isValidId(hallId);
      allow list: if true;
      allow create: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
          (
            isVerifiedAccount() &&
            incoming().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
          ) || (
            managerHasHallsPermission(incoming().restaurantId) &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
          ) || (
            isSuperAdmin() &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
          )
        );
      allow update: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'name_en', 'hallType', 'tableCount', 'tableNumbers', 'sortOrder', 'updatedAt'
        ]) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          isSuperAdmin() || (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          ) ||
          managerHasHallsPermission(existing().restaurantId)
        );
      allow delete: if isValidId(hallId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        ) ||
        managerHasHallsPermission(existing().restaurantId)
      );
    }

    // 9. Platform Settings CMS collection (public read for landing & ui_config, Super Admin write)
    match /platform_settings/{settingId} {
      allow get: if settingId in ['landing', 'ui_config'];
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && (
        (settingId == 'landing' &&
          isValidPlatformLanding(incoming()) &&
          incoming().updatedAt == request.time) ||
        (settingId == 'ui_config' &&
          isValidPlatformUiConfig(incoming()) &&
          incoming().updatedAt == request.time)
      );
      allow delete: if false;
    }

    // 10. Custom Injected Themes collection (public read, Super Admin write only)
    match /custom_themes/{themeId} {
      allow get: if isValidId(themeId);
      allow list: if isSuperAdmin() || resource.data.isActive == true;
      allow create: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().createdAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isActive']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'name_en', 'description', 'description_en', 'previewImage', 'htmlCode', 'cssCode', 'jsCode', 'isActive'
          ])
        );
      allow delete: if isSuperAdmin() && isValidId(themeId);
    }

    // 11. Platform SaaS Promo Codes collection (Super Admin full CRUD; verified owners single-code get only)
    match /platform_promo_codes/{promoId} {
      allow get: if isVerifiedAccount() && isValidPromoCodeId(promoId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidPlatformPromoCode(incoming(), promoId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidPlatformPromoCode(incoming(), promoId) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isSuperAdmin() && isValidPromoCodeId(promoId);
    }
  }
}
