rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 64 && slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    function isValidThemeId(themeId) {
      return themeId in [
        'theme-1', 'theme-2', 'theme-3', 'theme-4', 'theme-5',
        'theme-6', 'theme-7', 'theme-8', 'theme-9', 'theme-11'
      ] || (
        themeId is string &&
        themeId.size() >= 8 &&
        themeId.size() <= 128 &&
        themeId.matches('^custom_[a-zA-Z0-9_\\-]+$')
      );
    }

    function isValidStation(val) {
      return val in ['kitchen', 'bar', 'pastry'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAccount() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isSuperAdmin() {
      return isVerifiedAccount() &&
        request.auth.token.email == 'tygosibs@gmail.com';
    }

    // Validation blueprints
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidSlugMapping(data, slugId) {
      return data.keys().hasAll(['slug', 'restaurantId', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['slug', 'restaurantId', 'ownerId', 'createdAt']) &&
        data.slug == slugId &&
        isValidSlug(data.slug) &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        (isSuperAdmin() || data.ownerId == request.auth.uid) &&
        data.createdAt is timestamp;
    }

    function isValidHexOrEmpty(val) {
      return val == '' || (val is string && val.size() >= 4 && val.size() <= 16 && val.matches('^#[0-9a-fA-F]{6}$'));
    }

    function isValidRestaurantShape(data, restId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'slug', 'name', 'whatsappNumber', 'activeTheme',
          'primaryColor', 'taxRate', 'serviceCharge', 'currency',
          'isOpen', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'slug', 'name', 'name_en', 'tagline', 'tagline_en',
          'whatsappNumber', 'logoUrl', 'shareTitle', 'shareTitle_en',
          'shareDescription', 'shareDescription_en', 'activeTheme', 'primaryColor',
          'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
          'taxRate', 'serviceCharge', 'deliveryFee', 'currency',
          'isOpen', 'isSuspended', 'offers', 'promoCodes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == restId &&
        isValidId(data.ownerId) &&
        isValidSlug(data.slug) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120)) &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 500)) &&
        (!('tagline_en' in data) || (data.tagline_en is string && data.tagline_en.size() <= 500)) &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 24 &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 300000)) &&
        (!('shareTitle' in data) || (data.shareTitle is string && data.shareTitle.size() <= 140)) &&
        (!('shareTitle_en' in data) || (data.shareTitle_en is string && data.shareTitle_en.size() <= 140)) &&
        (!('shareDescription' in data) || (data.shareDescription is string && data.shareDescription.size() <= 300)) &&
        (!('shareDescription_en' in data) || (data.shareDescription_en is string && data.shareDescription_en.size() <= 300)) &&
        isValidThemeId(data.activeTheme) &&
        data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 16 && data.primaryColor.matches('^#[0-9a-fA-F]{6}$') &&
        (!('colorMode' in data) || (data.colorMode in ['auto', 'light', 'dark'])) &&
        (!('headingColor' in data) || isValidHexOrEmpty(data.headingColor)) &&
        (!('descriptionColor' in data) || isValidHexOrEmpty(data.descriptionColor)) &&
        (!('priceColor' in data) || isValidHexOrEmpty(data.priceColor)) &&
        (!('menuColumns' in data) || (data.menuColumns in [1, 2, 3])) &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        data.serviceCharge is number && data.serviceCharge >= 0 && data.serviceCharge <= 100 &&
        (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000)) &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 16 &&
        data.isOpen is bool &&
        (!('isSuspended' in data) || data.isSuspended is bool) &&
        (!('offers' in data) || (data.offers is list && data.offers.size() <= 12 && (data.offers.size() == 0 || data.offers[0] is map))) &&
        (!('promoCodes' in data) || (data.promoCodes is list && data.promoCodes.size() <= 20 && (data.promoCodes.size() == 0 || data.promoCodes[0] is map))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategoryShape(data, catId) {
      return data.keys().hasAll(['id', 'restaurantId', 'ownerId', 'name', 'sortOrder', 'createdAt']) &&
        data.keys().hasOnly(['id', 'restaurantId', 'ownerId', 'parentId', 'name', 'name_en', 'imageUrl', 'station', 'sortOrder', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == catId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        (!('parentId' in data) || data.parentId == '' || isValidId(data.parentId)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 80)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 300000)) &&
        (!('station' in data) || isValidStation(data.station)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp;
    }

    function isValidMenuItemShape(data, itemId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'categoryId', 'name',
          'basePrice', 'isSpicy', 'isAvailable', 'ordersCount',
          'sizes', 'addons', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'categoryId', 'name', 'name_en',
          'description', 'description_en', 'basePrice', 'imageUrl', 'calories',
          'isSpicy', 'isAvailable', 'ordersCount',
          'sizes', 'addons', 'badge', 'isBogo', 'suggestedItemIds', 'station',
          'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == itemId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        isValidId(data.categoryId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 500)) &&
        data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 100000 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 300000)) &&
        (!('calories' in data) || (data.calories is number && data.calories >= 0 && data.calories <= 10000)) &&
        data.isSpicy is bool &&
        data.isAvailable is bool &&
        data.ordersCount is number && data.ordersCount >= 0 && data.ordersCount <= 1000000 &&
        data.sizes is list && data.sizes.size() <= 10 && (data.sizes.size() == 0 || data.sizes[0] is map) &&
        data.addons is list && data.addons.size() <= 20 && (data.addons.size() == 0 || data.addons[0] is map) &&
        (!('badge' in data) || (data.badge in ['', 'none', 'best_seller', 'trending_week', 'chef_choice', 'bogo', 'new'])) &&
        (!('isBogo' in data) || data.isBogo is bool) &&
        (!('suggestedItemIds' in data) || (data.suggestedItemIds is list && data.suggestedItemIds.size() <= 8 && (data.suggestedItemIds.size() == 0 || data.suggestedItemIds[0] is string))) &&
        (!('station' in data) || isValidStation(data.station)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'orderNumber', 'customerName',
          'customerPhone', 'orderType', 'items', 'subtotal', 'serviceCharge',
          'taxAmount', 'total', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'orderNumber', 'customerName',
          'customerPhone', 'orderType', 'hallName', 'tableNumber', 'sessionId',
          'isGroupOrder', 'guestChecks', 'deliveryAddress',
          'notes', 'items', 'subtotal', 'serviceCharge', 'deliveryFee',
          'discountAmount', 'promoCode', 'taxAmount', 'total',
          'status', 'itemProgress', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == orderId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.orderType in ['dine_in', 'delivery', 'pickup'] &&
        (
          data.orderType == 'dine_in'
            ? (data.customerPhone is string && data.customerPhone.size() <= 24)
            : (data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 24)
        ) &&
        (!('hallName' in data) || (data.hallName is string && data.hallName.size() <= 60)) &&
        (!('tableNumber' in data) || (data.tableNumber is string && data.tableNumber.size() <= 20)) &&
        (!('sessionId' in data) || data.sessionId == '' || isValidId(data.sessionId)) &&
        (!('isGroupOrder' in data) || data.isGroupOrder is bool) &&
        (!('guestChecks' in data) || (data.guestChecks is list && data.guestChecks.size() <= 30 && (data.guestChecks.size() == 0 || data.guestChecks[0] is map))) &&
        (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 80 && data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000 &&
        data.serviceCharge is number && data.serviceCharge >= 0 && data.serviceCharge <= 1000000 &&
        (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000)) &&
        (!('discountAmount' in data) || (data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000)) &&
        (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 32)) &&
        data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 1000000 &&
        data.total is number && data.total >= 0 && data.total <= 1000000 &&
        data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
        (!('itemProgress' in data) || (data.itemProgress is map && data.itemProgress.size() <= 80)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTableSession(data, restaurantId, sessionId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'status', 'guests', 'items', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'status', 'guests', 'items', 'lastOrderNumber', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == sessionId &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        data.hallName is string && data.hallName.size() <= 60 &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 20 &&
        data.status in ['active', 'closed'] &&
        data.guests is list && data.guests.size() <= 30 && (data.guests.size() == 0 || data.guests[0] is string) &&
        data.items is list && data.items.size() <= 80 && (data.items.size() == 0 || data.items[0] is map) &&
        (!('lastOrderNumber' in data) || (data.lastOrderNumber is string && data.lastOrderNumber.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServiceCall(data, callId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'guestName', 'callType', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'sessionId', 'guestName', 'callType', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == callId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.hallName is string && data.hallName.size() <= 60 &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 20 &&
        (!('sessionId' in data) || data.sessionId == '' || isValidId(data.sessionId)) &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 60 &&
        data.callType in ['call_waiter', 'request_bill_cash', 'request_bill_card', 'cutlery_water'] &&
        data.status in ['pending', 'acknowledged', 'resolved'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHallShape(data, hallId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'name', 'tableCount', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'name', 'name_en', 'tableCount', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == hallId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 80)) &&
        data.tableCount is number && data.tableCount >= 1 && data.tableCount <= 200 &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPlatformLanding(data) {
      return data.keys().hasAll([
          'heroTitle', 'heroSubtitle', 'ctaButtonText', 'features',
          'pricingPlans', 'supportWhatsapp', 'footerText', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'heroTitle', 'heroTitle_en', 'heroSubtitle', 'heroSubtitle_en',
          'ctaButtonText', 'ctaButtonText_en', 'features',
          'pricingPlans', 'supportWhatsapp', 'footerText', 'footerText_en',
          'platformLogoUrl', 'shareTitle', 'shareTitle_en',
          'shareDescription', 'shareDescription_en', 'updatedAt'
        ]) &&
        data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 200 &&
        (!('heroTitle_en' in data) || (data.heroTitle_en is string && data.heroTitle_en.size() <= 200)) &&
        data.heroSubtitle is string && data.heroSubtitle.size() >= 1 && data.heroSubtitle.size() <= 600 &&
        (!('heroSubtitle_en' in data) || (data.heroSubtitle_en is string && data.heroSubtitle_en.size() <= 600)) &&
        data.ctaButtonText is string && data.ctaButtonText.size() >= 1 && data.ctaButtonText.size() <= 80 &&
        (!('ctaButtonText_en' in data) || (data.ctaButtonText_en is string && data.ctaButtonText_en.size() <= 80)) &&
        data.features is list && data.features.size() <= 12 && (data.features.size() == 0 || data.features[0] is map) &&
        data.pricingPlans is list && data.pricingPlans.size() <= 6 && (data.pricingPlans.size() == 0 || data.pricingPlans[0] is map) &&
        data.supportWhatsapp is string && data.supportWhatsapp.size() <= 32 &&
        data.footerText is string && data.footerText.size() >= 1 && data.footerText.size() <= 200 &&
        (!('footerText_en' in data) || (data.footerText_en is string && data.footerText_en.size() <= 200)) &&
        (!('platformLogoUrl' in data) || (data.platformLogoUrl is string && data.platformLogoUrl.size() <= 300000)) &&
        (!('shareTitle' in data) || (data.shareTitle is string && data.shareTitle.size() <= 140)) &&
        (!('shareTitle_en' in data) || (data.shareTitle_en is string && data.shareTitle_en.size() <= 140)) &&
        (!('shareDescription' in data) || (data.shareDescription is string && data.shareDescription.size() <= 300)) &&
        (!('shareDescription_en' in data) || (data.shareDescription_en is string && data.shareDescription_en.size() <= 300)) &&
        data.updatedAt is timestamp;
    }

    function isValidCustomTheme(data, themeId) {
      return data.keys().hasAll([
          'id', 'name', 'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'name_en', 'description', 'description_en', 'previewImage',
          'htmlCode', 'cssCode', 'jsCode', 'isActive', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        data.id == themeId &&
        data.id.matches('^custom_[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 100)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 400)) &&
        (!('previewImage' in data) || (data.previewImage is string && data.previewImage.size() <= 300000)) &&
        data.htmlCode is string && data.htmlCode.size() <= 150000 &&
        data.cssCode is string && data.cssCode.size() <= 100000 &&
        data.jsCode is string && data.jsCode.size() <= 100000 &&
        data.isActive is bool &&
        data.createdAt is timestamp;
    }

    // 1. Users collection (owner-only PII + Super Admin read)
    match /users/{userId} {
      allow get: if isSuperAdmin() || (isVerifiedAccount() && isValidId(userId) && request.auth.uid == userId);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedAccount() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // 2. Slugs lookup collection
    match /slugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if isSuperAdmin();
      allow create: if isVerifiedAccount() && isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().createdAt == request.time;
      allow update: if isValidSlug(slug) &&
        isValidSlugMapping(incoming(), slug) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['restaurantId']) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      allow delete: if isValidSlug(slug) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 3. Restaurants collection
    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId);
      allow list: if isSuperAdmin() || (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerifiedAccount() && isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(restaurantId) &&
        isValidRestaurantShape(incoming(), restaurantId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid && (
              incoming().diff(existing()).affectedKeys().hasOnly(['activeTheme', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ])
            )
          ) || (
            isSuperAdmin() && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isSuspended', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['offers', 'promoCodes', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'activeTheme', 'primaryColor', 'taxRate', 'serviceCharge',
                'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
                'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'name_en', 'tagline', 'tagline_en', 'slug', 'whatsappNumber', 'logoUrl',
                'shareTitle', 'shareTitle_en', 'shareDescription', 'shareDescription_en',
                'currency', 'isOpen', 'isSuspended', 'activeTheme', 'taxRate', 'serviceCharge', 'deliveryFee',
                'primaryColor', 'colorMode', 'headingColor', 'descriptionColor', 'priceColor',
                'menuColumns', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isValidId(restaurantId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );

      // 3b. Table Sessions subcollection (Live Group Cart per dining table)
      match /table_sessions/{sessionId} {
        allow get: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId));
        allow list: if isValidId(restaurantId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && resource.data.ownerId == request.auth.uid)
        );
        allow create: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().status == 'active' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
          get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == incoming().ownerId;
        allow update: if isValidId(restaurantId) &&
          isValidId(sessionId) &&
          isValidTableSession(incoming(), restaurantId, sessionId) &&
          incoming().id == existing().id &&
          incoming().restaurantId == existing().restaurantId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && (
            (
              existing().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              existing().status == 'closed' &&
              incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'hallName', 'tableNumber', 'lastOrderNumber', 'updatedAt'
              ])
            ) || (
              (isSuperAdmin() || (isVerifiedAccount() && existing().ownerId == request.auth.uid)) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'guests', 'items', 'lastOrderNumber', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(restaurantId) && isValidId(sessionId) && (
          isSuperAdmin() ||
          (isVerifiedAccount() && existing().ownerId == request.auth.uid)
        );
      }
    }

    // 4. Categories collection (linked by restaurantId)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().createdAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(categoryId) &&
        isValidCategoryShape(incoming(), categoryId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'parentId', 'name', 'name_en', 'imageUrl', 'station', 'sortOrder'
        ]) && (
          (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          ) ||
          isSuperAdmin()
        );
      allow delete: if isValidId(categoryId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 5. Menu Items collection (linked by restaurantId and categoryId)
    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (
            exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          ) || (
            existsAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
              (
                isVerifiedAccount() &&
                incoming().ownerId == request.auth.uid &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
              ) || (
                isSuperAdmin() &&
                getAfter(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
              )
            )
          )
        );
      allow update: if isValidId(itemId) &&
        isValidMenuItemShape(incoming(), itemId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          (
            (
              isSuperAdmin() || (
                isVerifiedAccount() &&
                existing().ownerId == request.auth.uid &&
                get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
              )
            ) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['isAvailable', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['sortOrder', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['station', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'categoryId', 'name', 'name_en', 'description', 'description_en', 'basePrice', 'imageUrl', 'calories',
                'isSpicy', 'isAvailable', 'ordersCount', 'sizes', 'addons', 'badge', 'isBogo', 'suggestedItemIds',
                'station', 'sortOrder', 'updatedAt'
              ])
            )
          ) || (
            incoming().categoryId == existing().categoryId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ordersCount', 'updatedAt']) &&
            incoming().ordersCount > existing().ordersCount &&
            incoming().ordersCount <= existing().ordersCount + 50
          )
        );
      allow delete: if isValidId(itemId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 6. Orders collection (linked by restaurantId, strict owner-only + Super Admin read)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        !(existing().status in ['completed', 'cancelled']) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['itemProgress', 'status', 'updatedAt'])
        ) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          isSuperAdmin() || (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          )
        );
      allow delete: if isSuperAdmin() && isValidId(orderId);
    }

    // 7. Service Calls collection (Captain / Waiter / Bill requests isolated to restaurant owner)
    match /service_calls/{callId} {
      allow get: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isVerifiedAccount() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId;
      allow update: if isValidId(callId) &&
        isValidServiceCall(incoming(), callId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isSuperAdmin() || (isVerifiedAccount() && existing().ownerId == request.auth.uid)) &&
        existing().status != 'resolved' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == existing().ownerId;
      allow delete: if isValidId(callId) && (
        isSuperAdmin() ||
        (isVerifiedAccount() && existing().ownerId == request.auth.uid)
      );
    }

    // 8. Halls / Dining Zones collection (zero-PII public lookup + strict owner write)
    match /halls/{hallId} {
      allow get: if isValidId(hallId);
      allow list: if true;
      allow create: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)) && (
          (
            isVerifiedAccount() &&
            incoming().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
          ) || (
            isSuperAdmin() &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == incoming().ownerId
          )
        );
      allow update: if isValidId(hallId) &&
        isValidHallShape(incoming(), hallId) &&
        incoming().id == existing().id &&
        incoming().restaurantId == existing().restaurantId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'name_en', 'tableCount', 'sortOrder', 'updatedAt'
        ]) &&
        exists(/databases/$(database)/documents/restaurants/$(existing().restaurantId)) && (
          isSuperAdmin() || (
            isVerifiedAccount() &&
            existing().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
          )
        );
      allow delete: if isValidId(hallId) && (
        isSuperAdmin() || (
          isVerifiedAccount() &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/restaurants/$(existing().restaurantId)).data.ownerId == request.auth.uid
        )
      );
    }

    // 9. Platform Settings CMS collection (public read for landing page, Super Admin write)
    match /platform_settings/{settingId} {
      allow get: if settingId == 'landing';
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() &&
        settingId == 'landing' &&
        isValidPlatformLanding(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 10. Custom Injected Themes collection (public read, Super Admin write only)
    match /custom_themes/{themeId} {
      allow get: if isValidId(themeId);
      allow list: if isSuperAdmin() || resource.data.isActive == true;
      allow create: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().createdAt == request.time;
      allow update: if isSuperAdmin() &&
        isValidId(themeId) &&
        isValidCustomTheme(incoming(), themeId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt && (
          incoming().diff(existing()).affectedKeys().hasOnly(['isActive']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'name_en', 'description', 'description_en', 'previewImage', 'htmlCode', 'cssCode', 'jsCode', 'isActive'
          ])
        );
      allow delete: if isSuperAdmin() && isValidId(themeId);
    }
  }
}
