rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoneId(phone) {
      return phone is string && phone.size() >= 6 && phone.size() <= 24 && phone.matches('^[0-9]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 64 && slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    function isValidThemeId(themeId) {
      return themeId in [
        'theme-1', 'theme-2', 'theme-3', 'theme-4', 'theme-5',
        'theme-6', 'theme-7', 'theme-8', 'theme-9', 'theme-11'
      ] || (
        themeId is string &&
        themeId.size() >= 8 &&
        themeId.size() <= 128 &&
        themeId.matches('^custom_[a-zA-Z0-9_\\-]+$')
      );
    }

    function isValidStation(val) {
      return val is string && val.size() >= 1 && val.size() <= 64 && val.matches('^[a-z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAccount() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isSuperAdmin() {
      return isVerifiedAccount() &&
        request.auth.token.email == 'tygosibs@gmail.com';
    }

    function isValidStaffRole(role) {
      return role in ['manager', 'cashier', 'kitchen', 'bar', 'pastry', 'captain', 'station_staff', 'custom'];
    }

    function isValidStaffScreen(scr) {
      return scr in ['staff_management', 'cashier', 'kitchen', 'bar', 'pastry', 'captain', 'halls'] ||
        (scr is string && scr.size() >= 9 && scr.size() <= 72 && scr.matches('^station:[a-z0-9_-]+$'));
    }

    function hasStaffAccess() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff_access/$(request.auth.uid));
    }

    function staffAccess() {
      return get(/databases/$(database)/documents/staff_access/$(request.auth.uid)).data;
    }

    function isActiveStaffForRestaurant(restId) {
      return isSignedIn() &&
        hasStaffAccess() &&
        staffAccess().restaurantId == restId &&
        staffAccess().isActive == true;
    }

    function isActiveManagerForRestaurant(restId) {
      return isActiveStaffForRestaurant(restId) &&
        staffAccess().role == 'manager';
    }

    function staffHasScreen(restId, screenName) {
      return isActiveStaffForRestaurant(restId) &&
        screenName in staffAccess().allowedScreens;
    }

    function staffHasAnyStationAccess(restId) {
      return isActiveStaffForRestaurant(restId) && (
        'kitchen' in staffAccess().allowedScreens ||
        'bar' in staffAccess().allowedScreens ||
        'pastry' in staffAccess().allowedScreens ||
        ('allowedStations' in staffAccess() && staffAccess().allowedStations is list && staffAccess().allowedStations.size() > 0)
      );
    }

    function staffHasAnyOrderScreen(restId) {
      return isActiveStaffForRestaurant(restId) && (
        'cashier' in staffAccess().allowedScreens ||
        'captain' in staffAccess().allowedScreens ||
        staffHasAnyStationAccess(restId)
      );
    }

    function isOwnerOfRestaurant(restId) {
      return isVerifiedAccount() &&
        exists(/databases/$(database)/documents/restaurants/$(restId)) &&
        get(/databases/$(database)/documents/restaurants/$(restId)).data.ownerId == request.auth.uid;
    }

    // Validation blueprints
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidSlugMapping(data, slugId) {
      return data.keys().hasAll(['slug', 'restaurantId', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly(['slug', 'restaurantId', 'ownerId', 'createdAt']) &&
        data.slug == slugId &&
        isValidSlug(data.slug) &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        (isSuperAdmin() || data.ownerId == request.auth.uid) &&
        data.createdAt is timestamp;
    }

    function isValidHexOrEmpty(val) {
      return val == '' || (val is string && val.size() >= 4 && val.size() <= 16 && val.matches('^#[0-9a-fA-F]{6}$'));
    }

    function isValidRestaurantShape(data, restId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'slug', 'name', 'whatsappNumber', 'activeTheme',
          'primaryColor', 'taxRate', 'serviceCharge', 'currency',
          'isOpen', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'slug', 'name', 'name_en', 'tagline', 'tagline_en',
          'whatsappNumber', 'logoUrl', 'shareTitle', 'shareTitle_en',
          'shareDescription', 'shareDescription_en', 'activeTheme', 'primaryColor',
          'colorMode', 'headingColor', 'descriptionColor', 'priceColor', 'menuColumns',
          'taxRate', 'serviceCharge', 'deliveryFee', 'currency',
          'isOpen', 'isSuspended', 'ownerBirthday',
          'appliedPlatformPromoCode', 'appliedPlatformPromoSummary', 'appliedPlatformPromoSummary_en',
          'offers', 'promoCodes', 'loyaltyConfig', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == restId &&
        isValidId(data.ownerId) &&
        isValidSlug(data.slug) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120)) &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 500)) &&
        (!('tagline_en' in data) || (data.tagline_en is string && data.tagline_en.size() <= 500)) &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 7 && data.whatsappNumber.size() <= 24 &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 300000)) &&
        (!('shareTitle' in data) || (data.shareTitle is string && data.shareTitle.size() <= 140)) &&
        (!('shareTitle_en' in data) || (data.shareTitle_en is string && data.shareTitle_en.size() <= 140)) &&
        (!('shareDescription' in data) || (data.shareDescription is string && data.shareDescription.size() <= 300)) &&
        (!('shareDescription_en' in data) || (data.shareDescription_en is string && data.shareDescription_en.size() <= 300)) &&
        isValidThemeId(data.activeTheme) &&
        data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 16 && data.primaryColor.matches('^#[0-9a-fA-F]{6}$') &&
        (!('colorMode' in data) || (data.colorMode in ['auto', 'light', 'dark'])) &&
        (!('headingColor' in data) || isValidHexOrEmpty(data.headingColor)) &&
        (!('descriptionColor' in data) || isValidHexOrEmpty(data.descriptionColor)) &&
        (!('priceColor' in data) || isValidHexOrEmpty(data.priceColor)) &&
        (!('menuColumns' in data) || (data.menuColumns in [1, 2, 3])) &&
        data.taxRate is number && data.taxRate >= 0 && data.taxRate <= 100 &&
        data.serviceCharge is number && data.serviceCharge >= 0 && data.serviceCharge <= 100 &&
        (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000)) &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 16 &&
        data.isOpen is bool &&
        (!('isSuspended' in data) || data.isSuspended is bool) &&
        (!('ownerBirthday' in data) || (
          data.ownerBirthday is string &&
          data.ownerBirthday.size() <= 16 &&
          (data.ownerBirthday == '' || data.ownerBirthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        )) &&
        (!('appliedPlatformPromoCode' in data) || (data.appliedPlatformPromoCode is string && data.appliedPlatformPromoCode.size() <= 32)) &&
        (!('appliedPlatformPromoSummary' in data) || (data.appliedPlatformPromoSummary is string && data.appliedPlatformPromoSummary.size() <= 160)) &&
        (!('appliedPlatformPromoSummary_en' in data) || (data.appliedPlatformPromoSummary_en is string && data.appliedPlatformPromoSummary_en.size() <= 160)) &&
        (!('offers' in data) || (data.offers is list && data.offers.size() <= 12 && (data.offers.size() == 0 || data.offers[0] is map))) &&
        (!('promoCodes' in data) || (data.promoCodes is list && data.promoCodes.size() <= 20 && (data.promoCodes.size() == 0 || data.promoCodes[0] is map))) &&
        (!('loyaltyConfig' in data) || (
          data.loyaltyConfig is map &&
          data.loyaltyConfig.keys().hasOnly([
            'enabled', 'firstOrderEnabled', 'promoBannerText', 'promoBannerText_en',
            'firstOrderDiscountPercent', 'punchCardEnabled', 'punchCardTarget',
            'punchCardDiscountPercent', 'punchCardRewardText', 'punchCardRewardText_en',
            'birthdayOfferText', 'birthdayOfferText_en', 'birthdayDiscountPercent',
            'birthdayWhatsappMessage'
          ]) &&
          (!('enabled' in data.loyaltyConfig) || data.loyaltyConfig.enabled is bool) &&
          (!('firstOrderEnabled' in data.loyaltyConfig) || data.loyaltyConfig.firstOrderEnabled is bool) &&
          (!('promoBannerText' in data.loyaltyConfig) || (data.loyaltyConfig.promoBannerText is string && data.loyaltyConfig.promoBannerText.size() <= 200)) &&
          (!('promoBannerText_en' in data.loyaltyConfig) || (data.loyaltyConfig.promoBannerText_en is string && data.loyaltyConfig.promoBannerText_en.size() <= 200)) &&
          (!('firstOrderDiscountPercent' in data.loyaltyConfig) || (data.loyaltyConfig.firstOrderDiscountPercent is number && data.loyaltyConfig.firstOrderDiscountPercent >= 0 && data.loyaltyConfig.firstOrderDiscountPercent <= 50)) &&
          (!('punchCardEnabled' in data.loyaltyConfig) || data.loyaltyConfig.punchCardEnabled is bool) &&
          (!('punchCardTarget' in data.loyaltyConfig) || (data.loyaltyConfig.punchCardTarget is number && data.loyaltyConfig.punchCardTarget >= 2 && data.loyaltyConfig.punchCardTarget <= 20)) &&
          (!('punchCardDiscountPercent' in data.loyaltyConfig) || (data.loyaltyConfig.punchCardDiscountPercent is number && data.loyaltyConfig.punchCardDiscountPercent >= 0 && data.loyaltyConfig.punchCardDiscountPercent <= 50)) &&
          (!('punchCardRewardText' in data.loyaltyConfig) || (data.loyaltyConfig.punchCardRewardText is string && data.loyaltyConfig.punchCardRewardText.size() <= 140)) &&
          (!('punchCardRewardText_en' in data.loyaltyConfig) || (data.loyaltyConfig.punchCardRewardText_en is string && data.loyaltyConfig.punchCardRewardText_en.size() <= 140)) &&
          (!('birthdayOfferText' in data.loyaltyConfig) || (data.loyaltyConfig.birthdayOfferText is string && data.loyaltyConfig.birthdayOfferText.size() <= 220)) &&
          (!('birthdayOfferText_en' in data.loyaltyConfig) || (data.loyaltyConfig.birthdayOfferText_en is string && data.loyaltyConfig.birthdayOfferText_en.size() <= 220)) &&
          (!('birthdayDiscountPercent' in data.loyaltyConfig) || (data.loyaltyConfig.birthdayDiscountPercent is number && data.loyaltyConfig.birthdayDiscountPercent >= 0 && data.loyaltyConfig.birthdayDiscountPercent <= 50)) &&
          (!('birthdayWhatsappMessage' in data.loyaltyConfig) || (data.loyaltyConfig.birthdayWhatsappMessage is string && data.loyaltyConfig.birthdayWhatsappMessage.size() <= 400))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerShape(data, restaurantId, customerPhone) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'fullName', 'phone',
          'birthDay', 'birthMonth', 'birthYear', 'preferredOrderType',
          'totalOrders', 'loyaltyCycleOrders', 'firstOrderDiscountUsed',
          'favoriteItems', 'lastOrderItems', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'fullName', 'phone',
          'birthDay', 'birthMonth', 'birthYear', 'preferredOrderType', 'address',
          'totalOrders', 'loyaltyCycleOrders', 'firstOrderDiscountUsed',
          'lastVisitAt', 'favoriteItems', 'lastOrderItems', 'createdAt', 'updatedAt'
        ]) &&
        isValidPhoneId(data.id) &&
        data.id == customerPhone &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
        isValidPhoneId(data.phone) &&
        data.phone == customerPhone &&
        data.birthDay is number && data.birthDay >= 1 && data.birthDay <= 31 &&
        data.birthMonth is number && data.birthMonth >= 1 && data.birthMonth <= 12 &&
        data.birthYear is number && data.birthYear >= 1920 && data.birthYear <= 2020 &&
        data.preferredOrderType in ['dine_in', 'delivery', 'pickup'] &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        data.totalOrders is number && data.totalOrders >= 0 && data.totalOrders <= 100000 &&
        data.loyaltyCycleOrders is number && data.loyaltyCycleOrders >= 0 && data.loyaltyCycleOrders <= 100 &&
        data.firstOrderDiscountUsed is bool &&
        (!('lastVisitAt' in data) || data.lastVisitAt is timestamp) &&
        data.favoriteItems is list && data.favoriteItems.size() <= 20 && (data.favoriteItems.size() == 0 || data.favoriteItems[0] is map) &&
        data.lastOrderItems is list && data.lastOrderItems.size() <= 30 && (data.lastOrderItems.size() == 0 || data.lastOrderItems[0] is map) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategoryShape(data, catId) {
      return data.keys().hasAll(['id', 'restaurantId', 'ownerId', 'name', 'sortOrder', 'createdAt']) &&
        data.keys().hasOnly(['id', 'restaurantId', 'ownerId', 'parentId', 'name', 'name_en', 'imageUrl', 'station', 'stationId', 'sortOrder', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == catId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        (!('parentId' in data) || data.parentId == '' || isValidId(data.parentId)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 80)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 300000)) &&
        (!('station' in data) || isValidStation(data.station)) &&
        (!('stationId' in data) || isValidStation(data.stationId)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp;
    }

    function isValidMenuItemShape(data, itemId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'categoryId', 'name',
          'basePrice', 'isSpicy', 'isAvailable', 'ordersCount',
          'sizes', 'addons', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'categoryId', 'name', 'name_en',
          'description', 'description_en', 'basePrice', 'imageUrl', 'calories',
          'isSpicy', 'isAvailable', 'ordersCount',
          'sizes', 'addons', 'badge', 'isBogo', 'suggestedItemIds', 'station', 'stationId',
          'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == itemId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        isValidId(data.categoryId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('name_en' in data) || (data.name_en is string && data.name_en.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('description_en' in data) || (data.description_en is string && data.description_en.size() <= 500)) &&
        data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 100000 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 300000)) &&
        (!('calories' in data) || (data.calories is number && data.calories >= 0 && data.calories <= 10000)) &&
        data.isSpicy is bool &&
        data.isAvailable is bool &&
        data.ordersCount is number && data.ordersCount >= 0 && data.ordersCount <= 1000000 &&
        data.sizes is list && data.sizes.size() <= 10 && (data.sizes.size() == 0 || data.sizes[0] is map) &&
        data.addons is list && data.addons.size() <= 20 && (data.addons.size() == 0 || data.addons[0] is map) &&
        (!('badge' in data) || (data.badge in ['', 'none', 'best_seller', 'trending_week', 'chef_choice', 'bogo', 'new'])) &&
        (!('isBogo' in data) || data.isBogo is bool) &&
        (!('suggestedItemIds' in data) || (data.suggestedItemIds is list && data.suggestedItemIds.size() <= 8 && (data.suggestedItemIds.size() == 0 || data.suggestedItemIds[0] is string))) &&
        (!('station' in data) || isValidStation(data.station)) &&
        (!('stationId' in data) || isValidStation(data.stationId)) &&
        data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'orderNumber', 'customerName',
          'customerPhone', 'orderType', 'items', 'subtotal', 'serviceCharge',
          'taxAmount', 'total', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'orderNumber', 'customerName',
          'customerPhone', 'orderType', 'hallName', 'tableNumber', 'sessionId',
          'isGroupOrder', 'guestChecks', 'deliveryAddress',
          'notes', 'items', 'subtotal', 'serviceCharge', 'deliveryFee',
          'discountAmount', 'promoCode', 'taxAmount', 'total',
          'status', 'itemProgress', 'itemProgressBy',
          'createdByUid', 'createdByName', 'createdByRole',
          'lastUpdatedByUid', 'lastUpdatedByName', 'lastUpdatedByRole',
          'closedByUid', 'closedByName', 'closedByRole',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == orderId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 32 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
        data.orderType in ['dine_in', 'delivery', 'pickup'] &&
        (
          data.orderType == 'dine_in'
            ? (data.customerPhone is string && data.customerPhone.size() <= 24)
            : (data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 24)
        ) &&
        (!('hallName' in data) || (data.hallName is string && data.hallName.size() <= 60)) &&
        (!('tableNumber' in data) || (data.tableNumber is string && data.tableNumber.size() <= 20)) &&
        (!('sessionId' in data) || data.sessionId == '' || isValidId(data.sessionId)) &&
        (!('isGroupOrder' in data) || data.isGroupOrder is bool) &&
        (!('guestChecks' in data) || (data.guestChecks is list && data.guestChecks.size() <= 30 && (data.guestChecks.size() == 0 || data.guestChecks[0] is map))) &&
        (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 300)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 80 && data.items[0] is map &&
        data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 1000000 &&
        data.serviceCharge is number && data.serviceCharge >= 0 && data.serviceCharge <= 1000000 &&
        (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000)) &&
        (!('discountAmount' in data) || (data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 1000000)) &&
        (!('promoCode' in data) || (data.promoCode is string && data.promoCode.size() <= 32)) &&
        data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 1000000 &&
        data.total is number && data.total >= 0 && data.total <= 1000000 &&
        data.status in ['pending', 'preparing', 'completed', 'cancelled'] &&
        (!('itemProgress' in data) || (data.itemProgress is map && data.itemProgress.size() <= 80)) &&
        (!('itemProgressBy' in data) || (data.itemProgressBy is map && data.itemProgressBy.size() <= 80)) &&
        (!('createdByUid' in data) || (data.createdByUid is string && data.createdByUid.size() <= 128)) &&
        (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100)) &&
        (!('createdByRole' in data) || (data.createdByRole is string && data.createdByRole.size() <= 32)) &&
        (!('lastUpdatedByUid' in data) || (data.lastUpdatedByUid is string && data.lastUpdatedByUid.size() <= 128)) &&
        (!('lastUpdatedByName' in data) || (data.lastUpdatedByName is string && data.lastUpdatedByName.size() <= 100)) &&
        (!('lastUpdatedByRole' in data) || (data.lastUpdatedByRole is string && data.lastUpdatedByRole.size() <= 32)) &&
        (!('closedByUid' in data) || (data.closedByUid is string && data.closedByUid.size() <= 128)) &&
        (!('closedByName' in data) || (data.closedByName is string && data.closedByName.size() <= 100)) &&
        (!('closedByRole' in data) || (data.closedByRole is string && data.closedByRole.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTableSession(data, restaurantId, sessionId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'status', 'guests', 'items', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'status', 'guests', 'items', 'lastOrderNumber', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == sessionId &&
        isValidId(data.restaurantId) &&
        data.restaurantId == restaurantId &&
        isValidId(data.ownerId) &&
        data.hallName is string && data.hallName.size() <= 60 &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 20 &&
        data.status in ['active', 'closed'] &&
        data.guests is list && data.guests.size() <= 30 && (data.guests.size() == 0 || data.guests[0] is string) &&
        data.items is list && data.items.size() <= 80 && (data.items.size() == 0 || data.items[0] is map) &&
        (!('lastOrderNumber' in data) || (data.lastOrderNumber is string && data.lastOrderNumber.size() <= 32)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidServiceCall(data, callId) {
      return data.keys().hasAll([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'guestName', 'callType', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'restaurantId', 'ownerId', 'hallName', 'tableNumber',
          'sessionId', 'guestName', 'callType', 'status',
          'handledByUid', 'handledByName', 'handledByRole',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == callId &&
        isValidId(data.restaurantId) &&
        isValidId(data.ownerId) &&
        data.hallName is string && data.hallName.size() <= 60 &&
        data.tableNumber is string && data.tableNumber.size() >= 1 && data.tableNumber.size() <= 20 &&
        (!('sessionId' in data) || data.sessionId == '' || isValidId(data.sessionId)) &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 60 &&
        data.callType in ['call_waiter', 'request_bill_cash', 'request_bill_card', 'cutlery_water'] &&
        data.status in ['pending', 'acknowledged', 'resolved'] &&
        (!('handledByUid' in data) || (data.handledByUid is string && data.handledByUid.size() <= 128)) &&
