        "ownerId",
        "orderNumber",
        "customerName",
        "customerPhone",
        "orderType",
        "items",
        "subtotal",
        "serviceCharge",
        "taxAmount",
        "total",
        "status",
        "createdAt",
        "updatedAt"
      ]
