{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated restaurant owner profile isolated from public storefront documents.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt"]
    },
    "SlugMapping": {
      "title": "SlugMapping",
      "description": "Unique URL slug index mapping slug to restaurantId and ownerId.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "restaurantId", "ownerId", "createdAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Multi-tenant restaurant configuration document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "name_en": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 500 },
        "tagline_en": { "type": "string", "maxLength": 500 },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 24 },
        "logoUrl": { "type": "string", "maxLength": 300000 },
        "shareTitle": { "type": "string", "maxLength": 140 },
        "shareTitle_en": { "type": "string", "maxLength": 140 },
        "shareDescription": { "type": "string", "maxLength": 300 },
        "shareDescription_en": { "type": "string", "maxLength": 300 },
        "activeTheme": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(theme-(?:[1-9]|1[0-1])|custom_[a-zA-Z0-9_\\-]+)$" },
        "primaryColor": { "type": "string", "minLength": 4, "maxLength": 16, "pattern": "^#[0-9a-fA-F]{6}$" },
        "colorMode": { "type": "string", "enum": ["auto", "light", "dark"] },
        "headingColor": { "type": "string", "maxLength": 16 },
        "descriptionColor": { "type": "string", "maxLength": 16 },
        "priceColor": { "type": "string", "maxLength": 16 },
        "menuColumns": { "type": "number" },
        "taxRate": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "isOpen": { "type": "boolean" },
        "isSuspended": { "type": "boolean" },
        "ownerBirthday": { "type": "string", "maxLength": 16 },
        "appliedPlatformPromoCode": { "type": "string", "maxLength": 32 },
        "appliedPlatformPromoSummary": { "type": "string", "maxLength": 160 },
        "appliedPlatformPromoSummary_en": { "type": "string", "maxLength": 160 },
        "offers": { "type": "array" },
        "promoCodes": { "type": "array" },
        "loyaltyConfig": { "$ref": "#/entities/LoyaltyConfig" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "slug",
        "name",
        "whatsappNumber",
        "activeTheme",
        "primaryColor",
        "taxRate",
        "serviceCharge",
        "currency",
        "isOpen",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category (main or subcategory via parentId) linked to a restaurant via restaurantId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name_en": { "type": "string", "maxLength": 80 },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "station": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_\\-]+$" },
        "stationId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_\\-]+$" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "restaurantId", "ownerId", "name", "sortOrder", "createdAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Menu item linked by restaurantId and categoryId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name_en": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "description_en": { "type": "string", "maxLength": 500 },
        "basePrice": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "calories": { "type": "number" },
        "isSpicy": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "ordersCount": { "type": "number" },
        "sizes": { "type": "array" },
        "addons": { "type": "array" },
        "badge": { "type": "string", "enum": ["none", "best_seller", "trending_week", "chef_choice", "bogo", "new"] },
        "isBogo": { "type": "boolean" },
        "suggestedItemIds": { "type": "array" },
        "station": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_\\-]+$" },
        "stationId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_\\-]+$" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "categoryId",
        "name",
        "basePrice",
        "isSpicy",
        "isAvailable",
        "ordersCount",
        "sizes",
        "addons",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order linked to restaurantId with owner-only read isolation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
