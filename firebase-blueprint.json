{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated restaurant owner profile isolated from public storefront documents.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt"]
    },
    "SlugMapping": {
      "title": "SlugMapping",
      "description": "Unique URL slug index mapping slug to restaurantId and ownerId.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "restaurantId", "ownerId", "createdAt"]
    },
    "Restaurant": {
      "title": "Restaurant",
      "description": "Multi-tenant restaurant configuration document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "name_en": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 500 },
        "tagline_en": { "type": "string", "maxLength": 500 },
        "whatsappNumber": { "type": "string", "minLength": 7, "maxLength": 24 },
        "logoUrl": { "type": "string", "maxLength": 300000 },
        "shareTitle": { "type": "string", "maxLength": 140 },
        "shareTitle_en": { "type": "string", "maxLength": 140 },
        "shareDescription": { "type": "string", "maxLength": 300 },
        "shareDescription_en": { "type": "string", "maxLength": 300 },
        "activeTheme": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(theme-(?:[1-9]|1[0-1])|custom_[a-zA-Z0-9_\\-]+)$" },
        "primaryColor": { "type": "string", "minLength": 4, "maxLength": 16, "pattern": "^#[0-9a-fA-F]{6}$" },
        "colorMode": { "type": "string", "enum": ["auto", "light", "dark"] },
        "headingColor": { "type": "string", "maxLength": 16 },
        "descriptionColor": { "type": "string", "maxLength": 16 },
        "priceColor": { "type": "string", "maxLength": 16 },
        "menuColumns": { "type": "number" },
        "taxRate": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "isOpen": { "type": "boolean" },
        "isSuspended": { "type": "boolean" },
        "offers": { "type": "array" },
        "promoCodes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerId",
        "slug",
        "name",
        "whatsappNumber",
        "activeTheme",
        "primaryColor",
        "taxRate",
        "serviceCharge",
        "currency",
        "isOpen",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Menu category (main or subcategory via parentId) linked to a restaurant via restaurantId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name_en": { "type": "string", "maxLength": 80 },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "station": { "type": "string", "enum": ["kitchen", "bar", "pastry"] },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "restaurantId", "ownerId", "name", "sortOrder", "createdAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Menu item linked by restaurantId and categoryId.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name_en": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "description_en": { "type": "string", "maxLength": 500 },
        "basePrice": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 300000 },
        "calories": { "type": "number" },
        "isSpicy": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "ordersCount": { "type": "number" },
        "sizes": { "type": "array" },
        "addons": { "type": "array" },
        "badge": { "type": "string", "enum": ["none", "best_seller", "trending_week", "chef_choice", "bogo", "new"] },
        "isBogo": { "type": "boolean" },
        "suggestedItemIds": { "type": "array" },
        "station": { "type": "string", "enum": ["kitchen", "bar", "pastry"] },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "categoryId",
        "name",
        "basePrice",
        "isSpicy",
        "isAvailable",
        "ordersCount",
        "sizes",
        "addons",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order linked to restaurantId with owner-only read isolation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 32 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 24 },
        "orderType": { "type": "string", "enum": ["dine_in", "delivery", "pickup"] },
        "hallName": { "type": "string", "maxLength": 60 },
        "tableNumber": { "type": "string", "maxLength": 20 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "isGroupOrder": { "type": "boolean" },
        "guestChecks": { "type": "array" },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 400 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "serviceCharge": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discountAmount": { "type": "number" },
        "promoCode": { "type": "string", "maxLength": 32 },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "completed", "cancelled"] },
        "itemProgress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "orderNumber",
        "customerName",
        "customerPhone",
        "orderType",
        "items",
        "subtotal",
        "serviceCharge",
        "taxAmount",
        "total",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "TableSession": {
      "title": "TableSession",
      "description": "Live shared dining table session storing collaborative group cart items tagged by guestName.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hallName": { "type": "string", "maxLength": 60 },
        "tableNumber": { "type": "string", "minLength": 1, "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "guests": { "type": "array" },
        "items": { "type": "array" },
        "lastOrderNumber": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "hallName",
        "tableNumber",
        "status",
        "guests",
        "items",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceCall": {
      "title": "ServiceCall",
      "description": "Real-time waiter/captain service alert sent from a dining table.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hallName": { "type": "string", "maxLength": 60 },
        "tableNumber": { "type": "string", "minLength": 1, "maxLength": 20 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "guestName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "callType": { "type": "string", "enum": ["call_waiter", "request_bill_cash", "request_bill_card", "cutlery_water"] },
        "status": { "type": "string", "enum": ["pending", "acknowledged", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "hallName",
        "tableNumber",
        "guestName",
        "callType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Hall": {
      "title": "Hall",
      "description": "Dining hall / floor zone with configurable table count for bulk QR generation and KDS/Waiter filtering.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "restaurantId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name_en": { "type": "string", "maxLength": 80 },
        "tableCount": { "type": "number" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "restaurantId",
        "ownerId",
        "name",
        "tableCount",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformLandingSettings": {
      "title": "PlatformLandingSettings",
      "description": "Dynamic CMS content for the platform landing page managed by Super Admin.",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "heroTitle_en": { "type": "string", "maxLength": 200 },
        "heroSubtitle": { "type": "string", "minLength": 1, "maxLength": 600 },
        "heroSubtitle_en": { "type": "string", "maxLength": 600 },
        "ctaButtonText": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ctaButtonText_en": { "type": "string", "maxLength": 80 },
        "features": { "type": "array" },
        "pricingPlans": { "type": "array" },
        "supportWhatsapp": { "type": "string", "maxLength": 32 },
        "footerText": { "type": "string", "minLength": 1, "maxLength": 200 },
        "footerText_en": { "type": "string", "maxLength": 200 },
        "platformLogoUrl": { "type": "string", "maxLength": 300000 },
        "shareTitle": { "type": "string", "maxLength": 140 },
        "shareTitle_en": { "type": "string", "maxLength": 140 },
        "shareDescription": { "type": "string", "maxLength": 300 },
        "shareDescription_en": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "heroTitle",
        "heroSubtitle",
        "ctaButtonText",
        "features",
        "pricingPlans",
        "supportWhatsapp",
        "footerText",
        "updatedAt"
      ]
    },
    "CustomTheme": {
      "title": "CustomTheme",
      "description": "Dynamic custom HTML/CSS/JS theme injected by Super Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^custom_[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name_en": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 400 },
        "description_en": { "type": "string", "maxLength": 400 },
        "previewImage": { "type": "string", "maxLength": 300000 },
        "htmlCode": { "type": "string", "maxLength": 150000 },
        "cssCode": { "type": "string", "maxLength": 100000 },
        "jsCode": { "type": "string", "maxLength": 100000 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "htmlCode",
        "cssCode",
        "jsCode",
        "isActive",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Restaurant owner profiles strictly isolated per user."
    },
    "/slugs/{slug}": {
      "schema": { "$ref": "#/entities/SlugMapping" },
      "description": "Unique URL slug mapping to restaurantId."
    },
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant configurations and branding settings."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Menu categories linked via restaurantId."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items linked via restaurantId and categoryId."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders linked via restaurantId and isolated to the restaurant owner."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformLandingSettings" },
      "description": "Platform-wide landing page CMS settings managed by Super Admin."
    },
    "/custom_themes/{themeId}": {
      "schema": { "$ref": "#/entities/CustomTheme" },
      "description": "Dynamic custom HTML/CSS/JS themes injected by Super Admin."
    },
    "/restaurants/{restaurantId}/table_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TableSession" },
      "description": "Live collaborative group cart sessions per dining table and hall."
    },
    "/service_calls/{callId}": {
      "schema": { "$ref": "#/entities/ServiceCall" },
      "description": "Real-time captain/waiter service call notifications linked to restaurantId and ownerId."
    },
    "/halls/{hallId}": {
      "schema": { "$ref": "#/entities/Hall" },
      "description": "Restaurant dining halls/zones and their table counts."
    }
  }
}
