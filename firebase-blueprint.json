  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Restaurant owner profiles strictly isolated per user."
    },
    "/slugs/{slug}": {
      "schema": { "$ref": "#/entities/SlugMapping" },
      "description": "Unique URL slug mapping to restaurantId."
    },
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Restaurant configurations and branding settings."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Menu categories linked via restaurantId."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items linked via restaurantId and categoryId."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders linked via restaurantId and isolated to the restaurant owner."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformLandingSettings" },
      "description": "Platform-wide landing page CMS settings managed by Super Admin."
    },
    "/platform_promo_codes/{promoId}": {
      "schema": { "$ref": "#/entities/PlatformPromoCode" },
      "description": "Platform-wide SaaS subscription promo codes managed by Super Admin."
    },
    "/custom_themes/{themeId}": {
      "schema": { "$ref": "#/entities/CustomTheme" },
      "description": "Dynamic custom HTML/CSS/JS themes injected by Super Admin."
    },
    "/restaurants/{restaurantId}/table_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TableSession" },
      "description": "Live collaborative group cart sessions per dining table and hall."
    },
    "/restaurants/{restaurantId}/customers/{customerPhone}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Per-restaurant registered customer loyalty profiles, birthdays, punch card progress, and favorite items."
    },
    "/service_calls/{callId}": {
      "schema": { "$ref": "#/entities/ServiceCall" },
      "description": "Real-time captain/waiter service call notifications linked to restaurantId and ownerId."
    },
    "/halls/{hallId}": {
      "schema": { "$ref": "#/entities/Hall" },
      "description": "Restaurant dining halls/zones and their table counts."
    },
    "/staff_access/{staffUid}": {
      "schema": { "$ref": "#/entities/StaffAccess" },
      "description": "RBAC lookup document keyed by staff Firebase Auth UID for rule-enforced multi-tenant role & screen isolation."
    },
    "/restaurants/{restaurantId}/staff/{staffUid}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Per-restaurant manager and staff profiles, roles, assigned screens, and hall linkage."
    },
    "/restaurants/{restaurantId}/staff_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/StaffInvite" },
      "description": "Single-use SHA-256 hashed staff onboarding invite tokens expiring in 24 hours."
    },
    "/restaurants/{restaurantId}/staff_login_index/{lookupId}": {
      "schema": { "$ref": "#/entities/StaffLoginIndex" },
      "description": "Hashed lookup records guaranteeing per-restaurant uniqueness and email resolution for username/phone logins."
    },
    "/restaurants/{restaurantId}/staff_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/StaffAuditLog" },
      "description": "Immutable operational and authentication accountability audit trail per restaurant."
    },
    "/restaurants/{restaurantId}/stations/{stationId}": {
      "schema": { "$ref": "#/entities/RestaurantStation" },
      "description": "Dynamic unlimited kitchen/prep stations configured per restaurant."
    },
    "/restaurants/{restaurantId}/staff_shifts/{shiftId}": {
      "schema": { "$ref": "#/entities/StaffShift" },
      "description": "Operational staff shifts per station/screen tracking active shift coverage and metrics."
    },
    "/restaurants/{restaurantId}/staff_devices/{deviceId}": {
      "schema": { "$ref": "#/entities/StaffDevice" },
      "description": "PWA browser notification registrations, FCM tokens, and active station topics per staff device."
    }
  }
}
